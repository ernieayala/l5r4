{
  "name": "l5r4-enhanced",
  "version": "3.2.1",
  "description": "Legend of the Five Rings 4e Enhanced system for Foundry VTT",
  "author": "Ernie Ayala",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ernieayala/l5r4.git"
  },
  "bugs": {
    "url": "https://github.com/ernieayala/l5r4/issues"
  },
  "homepage": "https://github.com/ernieayala/l5r4#readme",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build:css": "sass --no-source-map scss/l5r4-enhanced.scss dist/l5r4-enhanced.css",
    "watch:css": "sass --no-source-map --watch scss/l5r4-enhanced.scss:dist/l5r4-enhanced.css",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"scss/**/*.scss\"",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "format": "prettier --write \"**/*.{js,mjs,css,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,css,scss,json,md}\"",
    "deps:circular": "madge --circular module/",
    "deps:analyze": "madge --summary module/ && madge --json module/ > madge-analysis.json",
    "release:prepare": "node scripts/prepare-release.js",
    "release:validate": "node scripts/prepare-release.js --validate-only",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
