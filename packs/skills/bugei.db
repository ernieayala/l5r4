{"_id":"skb0001","name":"Athletics","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Climbing, running, swimming, throwing. Moderate terrain negated at Rank 3. No terrain penalties at Rank 5. [CR p.100]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"str","availableEmphases":["Climbing","Running","Swimming","Throwing"],"trainedEmphases":[],"mastery3":"Moderate Terrain no longer impedes movement, and movement across Difficult Terrain reduces the character's Water Ring by 1 instead of 2.","mastery5":"The character no longer suffers movement penalties regardless of terrain.","mastery7":"The character may add 5 feet to the total of one Move Action per Round (this does not increase his maximum possible movement per round).","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Athletics Mastery 3","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"Moderate Terrain no longer impedes movement, and movement across Difficult Terrain reduces the character's Water Ring by 1 instead of 2."}}},{"name":"Athletics Mastery 5","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"The character no longer suffers movement penalties regardless of terrain."}}},{"name":"Athletics Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"The character may add 5 feet to the total of one Move Action per Round (this does not increase his maximum possible movement per round)."}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":100000,"ownership":{"defau