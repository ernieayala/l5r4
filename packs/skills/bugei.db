{"_id":"skb0006","name":"Iaijutsu","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Formal dueling. Ready katana as Free Action at Rank 3. Free Raise on Focus at Rank 5. +2k2 on Assessment at Rank 7. [CR p.102]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"ref","availableEmphases":["Assessment","Focus"],"trainedEmphases":[],"mastery3":"Readying a katana is a Free Action rather than a Simple Action.","mastery5":"During an Iaijutsu Duel, the character gains one Free Raise on his Iaijutsu (Focus) / Void roll during the Focus Stage.","mastery7":"During the Assessment portion of an Iaijutsu Duel, the character gains a bonus of +2k2 to the total of all Focus Rolls if his Assessment roll exceeds his opponent's by 10 or more (instead of the normal +1k1).","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Iaijutsu Mastery 3","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"Readying a katana is a Free Action rather than a Simple Action."}}},{"name":"Iaijutsu Mastery 5","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"During an Iaijutsu Duel, the character gains one Free Raise on his Iaijutsu (Focus) / Void roll during the Focus Stage."}}},{"name":"Iaijutsu Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"During the Assessment portion of an Iaijutsu Duel, the character gains a bonus of +2k2 to the total of all Focus Rolls if his Assessment roll exceeds his opponent's by 10 or more (instead of the normal +1k1)."}}}