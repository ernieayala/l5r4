{"_id":"skb0003","name":"Defense","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Required for Defense and Full Defense Stances. Increases Armor TN. Retain roll at Rank 3, +3 TN at Rank 5, Simple Action at Rank 7. [CR p.101]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"ref","availableEmphases":[],"trainedEmphases":[],"mastery3":"The character may retain the result of a previous Defense / Reflexes roll rather than make a new roll if the Full Defense Stance is being maintained in subsequent rounds.","mastery5":"The character's Armor TN is considered 3 higher in the Defense and Full Defense Stances.","mastery7":"One Simple Action may be taken while in the Full Defense Stance (no attacks may be made).","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Defense Mastery 3: Retain Roll","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"May retain previous Defense/Reflexes roll if maintaining Full Defense Stance"}}},{"name":"Defense Mastery 5: Stance Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":true,"transfer":true,"changes":[{"key":"system.armor.armorTn","mode":2,"value":"3","priority":20}],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"toggleable":true,"description":"Active in Defense or Full Defense Stance only"}}},{"name":"Defense Mastery 7: Action in Stance","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"One Simple Action may be taken while in Full Defense Stance (no attacks)"}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":300000,"ownership":{"default":0},"flags":{}}
{"_id":"skb0004","name":"Horsemanship","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Ride horses in difficult conditions. Full Attack on horseback at Rank 3. Mount as Simple/Free at Rank 5/7. [CR p.101]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"agi","availableEmphases":["Gaijin Riding Horse","Rokugani Pony","Utaku Steed"],"trainedEmphases":[],"mastery3":"The character may utilize the Full Attack Stance when on horseback.","mastery5":"Mounting a horse is a Simple Action rather than a Complex Action, and dismounting is a Free Action rather than a Simple Action.","mastery7":"Mounting a horse is a Free Action rather than a Simple Action.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Horsemanship Mastery 3","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"The character may utilize the Full Attack Stance when on horseback."}}},{"name":"Horsemanship Mastery 5","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"Mounting a horse is a Simple Action rather than a Complex Action, and dismounting is a Free Action rather than a Simple Action."}}},{"name":"Horsemanship Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"Mounting a horse is a Free Action rather than a Simple Action."}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":400000,"ownership":{"default":0},"flags":{}}
