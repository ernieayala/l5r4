{"_id":"skb0015","name":"Polearms","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Naginata, bisento. +5 Initiative first round at Rank 3, +1k0 vs mounted/large at Rank 5, ready as Free Action at Rank 7. [CR p.105]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"agi","availableEmphases":["Bisento","Nagamaki","Naginata","Sasumata","Sodegarami"],"trainedEmphases":[],"mastery3":"During the first round of a skirmish, a character wielding a polearm gains a bonus of +5 to his Initiative Score. This lasts for only the first round.","mastery5":"Damage rolls made with polearms against mounted or significantly larger opponents is increased by +1k0.","mastery7":"Polearms may be readied as a Free Action.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Polearms Mastery 3: Initiative Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":true,"transfer":true,"changes":[{"key":"system.initiative.totalMod","mode":2,"value":"5","priority":20}],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"toggleable":true,"description":"Active during first round of skirmish only"}}},{"name":"Polearms Mastery 5: Mounted Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"toggleable":true,"template":true,"instructions":"Damage rolls increased by +1k0 against mounted or significantly larger opponents"}}},{"name":"Polearms Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"Polearms may be readied as a Free Action."}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":1500000,"ownership":{"default":0},"flags":{}}
{"_id":"skb0016","name":"Spears","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Yari, lance. Ignore 3 Reduction first round at Rank 3, +5 ranged range at Rank 5, ready as Free Action at Rank 7. [CR p.105]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"agi","availableEmphases":["Mai Chong","Kumade","Lance","Nage-yari","Yari"],"trainedEmphases":[],"mastery3":"During the first round of a skirmish, a character wielding a spear may ignore 3 points of Reduction when making melee attacks against his opponent.","mastery5":"Ranged attacks made using a spear increase their maximum possible range by 5.","mastery7":"Spears may be readied as a Free Action.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Spears Mastery 3","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"During the first round of a skirmish, a character wielding a spear may ignore 3 points of Reduction when making melee attacks against his opponent."}}},{"name":"Spears Mastery 5","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"Ranged attacks made using a spear increase their maximum possible range by 5."}}},{"name":"Spears Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"Spears may be readied as a Free Action."}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":1600000,"ownership":{"default":0},"flags":{}}
{"_id":"skb0017","name":"Staves","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Bo, jo, nunchaku. Armor bonus not doubled at Rank 3, Free Raise Knockdown at Rank 5, ready/damage bonus at Rank 7. [CR p.106]","specialRules":"","freeRaises":0,"rank":0,"type":"bugei","trait":"agi","availableEmphases":["Bo","Jo","Machi-kanshisha","Nunchaku","Sang Kauw","Tonfa"],"trainedEmphases":[],"mastery3":"Opponents' armor bonuses are no longer doubled against staff attacks.","mastery5":"Use of a staff confers one Free Raise toward use of the Knockdown Maneuver.","mastery7":"Staves that are large may be readied as a Free Action instead of a Simple Action. Staves that are small gain a bonus to damage rolls equal to +1k0.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Staves Mastery 3","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"Opponents' armor bonuses are no longer doubled against staff attacks."}}},{"name":"Staves Mastery 5","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"Use of a staff confers one Free Raise toward use of the Knockdown Maneuver."}}},{"name":"Staves Mastery 7","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"Staves that are large may be readied as a Free Action instead of a Simple Action. Staves that are small gain a bonus to damage rolls equal to +1k0."}}}],"folder":"L5R4 Enhanced/Skills/Bugei","sort":1700000,"ownership":{"default":0},"flags":{}}
