{"_id":"skm0001","name":"Animal Handling","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Train and command domesticated animals. Train for others at Rank 3, command to attack at Rank 5, non-verbal commands at Rank 7. [CR p.107]","specialRules":"","freeRaises":0,"rank":0,"type":"merchant","trait":"awa","availableEmphases":["Dogs","Falcons","Horses"],"trainedEmphases":[],"mastery3":"Commonly domesticated animals such as dogs, horses, or falcons may be trained for use by others.","mastery5":"Trained animals still in possession of the trainer may be commanded to attack a target of his choosing. The animal will flee for its life if badly wounded regardless of commands issued.","mastery7":"Animals trained by the character may be issued commands non-verbally.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Animal Handling Mastery 3: Train for Others","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"Commonly domesticated animals (dogs, horses, falcons) may be trained for use by others"}}},{"name":"Animal Handling Mastery 5: Command Attack","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"Trained animals in possession may be commanded to attack. Animal flees if badly wounded."}}},{"name":"Animal Handling Mastery 7: Non-Verbal Commands","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"Animals trained by character may be issued commands non-verbally"}}}],"folder":"L5R4 Enhanced/Skills/Merchant","sort":100000,"ownership":{"default":0},"flags":{}}
