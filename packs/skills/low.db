{"_id":"skl0001","name":"Forgery","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Create false documents, seals, or artwork. Forgery roll sets TN for Investigation to detect. Craft Skill for targeting effects. [CR p.100]","specialRules":"","freeRaises":0,"rank":0,"type":"low","trait":"agi","availableEmphases":["Artwork","Documents","Personal Seals"],"trainedEmphases":[],"mastery3":"The character gains a bonus of +1k0 to his Forgery Skill Roll result for the purposes of establishing the TN of an Investigation / Perception Skill Roll to detect it.","mastery5":"The character gains a bonus of +1k0 on any roll to detect a forgery made by someone else.","mastery7":"The character gains a bonus of +0k1 (for a total of +1k1) to his Forgery Skill Roll result for the purposes of establishing the TN of an Investigation / Perception Skill Roll to detect it.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Forgery Mastery 3: Detection TN Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[{"key":"system.bonuses.skill.forgery.roll","mode":2,"value":"1","priority":20}],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"toggleable":false,"description":"+1k0 to Forgery roll for setting detection TN"}}},{"name":"Forgery Mastery 5: Detect Forgery Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":true,"transfer":true,"changes":[{"key":"system.bonuses.skill.forgery.roll","mode":2,"value":"1","priority":20}],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"toggleable":true,"description":"Active when detecting forgeries made by others"}}},{"name":"Forgery Mastery 7: Enhanced Detection TN","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[{"key":"system.bonuses.skill.forgery.keep","mode":2,"value":"1","priority":20}],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"toggleable":false,"description":"+0k1 to Forgery roll for detection TN (total +1k1 with Rank 3)"}}}],"folder":"L5R4 Enhanced/Skills/Low","sort":100000,"ownership":{"default":0},"flags":{}}
{"_id":"skl0002","name":"Intimidation","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Manipulate through threats (Bullying, Control, Torture). Contested vs Etiquette/Willpower + target's Honor Rank. [CR p.100]","specialRules":"","freeRaises":0,"rank":0,"type":"low","trait":"awa","availableEmphases":["Bullying","Control","Torture"],"trainedEmphases":[],"mastery3":"","mastery5":"The character gains a bonus of +5 to the total of any Contested Roll made using Intimidation.","mastery7":"","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Intimidation Mastery 5: Contested Roll Bonus","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"toggleable":true,"template":true,"instructions":"+5 to total of any Contested Roll using Intimidation"}}}],"folder":"L5R4 Enhanced/Skills/Low","sort":200000,"ownership":{"default":0},"flags":{}}
