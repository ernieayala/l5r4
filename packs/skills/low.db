{"_id":"skl0004","name":"Stealth","type":"skill","img":"systems/l5r4-enhanced/assets/icons/skill.webp","system":{"description":"Move unseen. Simple Move = Water Ring distance. Ambush/Shadowing/Sneaking/Spell Casting emphases. No honor loss for Sneaking. [CR p.101]","specialRules":"","freeRaises":0,"rank":0,"type":"low","trait":"agi","availableEmphases":["Ambush","Shadowing","Sneaking","Spell Casting"],"trainedEmphases":[],"mastery3":"A character's Simple Move Actions while using Stealth allow him to move a distance equal to his Water x 5.","mastery5":"A character's Simple Move Actions while using Stealth allow him to move a distance equal to his Water x 10.","mastery7":"A character using Stealth may make Free Move Actions as normal.","insightBonus":0,"school":false,"freeRanks":0,"freeEmphasis":0,"rollBonus":0,"keepBonus":0,"totalBonus":0},"effects":[{"name":"Stealth Mastery 3: Enhanced Movement","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":3,"template":true,"instructions":"Simple Move Actions while using Stealth = Water Ring × 5"}}},{"name":"Stealth Mastery 5: Greater Movement","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":5,"template":true,"instructions":"Simple Move Actions while using Stealth = Water Ring × 10"}}},{"name":"Stealth Mastery 7: Free Movement","icon":"systems/l5r4-enhanced/assets/icons/skill.webp","disabled":false,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"category":"mastery","rank":7,"template":true,"instructions":"May make Free Move Actions as normal while using Stealth"}}}],"folder":"L5R4 Enhanced/Skills/Low","sort":400000,"ownership":{"default":0},"flags":{}}
