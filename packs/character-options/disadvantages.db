{"_id":"dis0001","name":"Antisocial","type":"disadvantage","img":"systems/l5r4-enhanced/assets/icons/disadvantage.webp","system":{"description":"<p>Social Skills penalty: -1k0 (2pts) or -1k1 (4pts). <strong>[CR p.156]</strong></p>","specialRules":"<p>If you take the 2 point version of this Disadvantage, you suffer a penalty of -1k0 to all Social Skill Rolls.</p>","cost":2,"type":"social","freeRaises":0},"effects":[{"name":"Antisocial Penalty (Configure)","icon":"systems/l5r4-enhanced/assets/icons/disadvantage.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"template":true,"instructions":"2pts: -1k0 to Social Skills, 4pts: -1k1 to Social Skills. Configure manually."}}}],"folder":"L5R4 Enhanced/Character Options/Disadvantages/Social","sort":100000,"ownership":{"default":0},"flags":{}}
