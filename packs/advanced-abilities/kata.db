{"_id":"kat0015","name":"Strength Of Purity Style","type":"kata","img":"systems/l5r4-enhanced/assets/icons/kata.webp","folder":"L5R4 Enhanced/Advanced Abilities/Kata","system":{"description":"Void 4 kata. Akodo Bushi, Kakita Bushi, Matsu Berserker, Utaku Battle Maiden. [CR p.176]","specialRules":"Once per turn while rolling damage, you may roll your Honor Rank instead of the normal Strength + DR of the weapon. You keep dice equal to the DR of the weapon as usual.","ring":"void","mastery":4,"schools":["Akodo Bushi","Kakita Bushi","Matsu Berserker","Utaku Battle Maiden"],"cost":4},"effects":[{"name":"Strength Of Purity Style (Activate)","icon":"systems/l5r4-enhanced/assets/icons/kata.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"template":true,"toggleable":true,"ring":"void","mastery":4,"instructions":"Void 4 kata. Toggle on when active. See description for effects."}}}],"sort":1500000,"ownership":{"default":0},"flags":{}}
{"_id":"kat0016","name":"Spinning Blades Style","type":"kata","img":"systems/l5r4-enhanced/assets/icons/kata.webp","folder":"L5R4 Enhanced/Advanced Abilities/Kata","system":{"description":"Fire 5 kata. Mirumoto Bushi, Yoritomo Bushi. [CR p.176]","specialRules":"Once per turn while wielding a weapon in each hand, you may make the Extra Attack Maneuver for 3 Raises instead of 5. The second attack comes from your off-hand weapon, dealing weapon damage as appropriate. You may not increase your damage on either attack via Raises.","ring":"fire","mastery":5,"schools":["Mirumoto Bushi","Yoritomo Bushi"],"cost":5},"effects":[{"name":"Spinning Blades Style (Activate)","icon":"systems/l5r4-enhanced/assets/icons/kata.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"template":true,"toggleable":true,"ring":"fire","mastery":5,"instructions":"Fire 5 kata. Toggle on when active. See description for effects."}}}],"sort":1600000,"ownership":{"default":0},"flags":{}}
