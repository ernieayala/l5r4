{"_id":"kat0007","name":"Breath Of Wind Style","type":"kata","img":"systems/l5r4-enhanced/assets/icons/kata.webp","folder":"L5R4 Enhanced/Advanced Abilities/Kata","system":{"description":"Air 3 kata. Kakita Bushi, Bayushi Bushi. [CR p.175]","specialRules":"Your Initiative Score increases by 2 during the Reactions Stage of each Combat Round. This effect stacks but disappears immediately if the kata is no longer in effect.","ring":"air","mastery":3,"schools":["Kakita Bushi","Bayushi Bushi"],"cost":3},"effects":[{"name":"Breath Of Wind Style: Initiative","icon":"systems/l5r4-enhanced/assets/icons/kata.webp","disabled":true,"transfer":true,"changes":[{"key":"system.initiative.totalMod","mode":2,"value":"2","priority":20}],"flags":{"l5r4-enhanced":{"toggleable":true,"description":"Increases during Reactions Stage each round. Toggle on when active."}}}],"sort":700000,"ownership":{"default":0},"flags":{}}
{"_id":"kat0008","name":"Disappearing World Style","type":"kata","img":"systems/l5r4-enhanced/assets/icons/kata.webp","folder":"L5R4 Enhanced/Advanced Abilities/Kata","system":{"description":"Fire 4 kata. Akodo Bushi, Kakita Bushi. [CR p.175]","specialRules":"Choose one opponent. Once per turn against that opponent, you may use your Agility Trait instead of your Strength Trait for damage rolls.","ring":"fire","mastery":4,"schools":["Akodo Bushi","Kakita Bushi"],"cost":4},"effects":[{"name":"Disappearing World Style (Activate)","icon":"systems/l5r4-enhanced/assets/icons/kata.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"template":true,"toggleable":true,"ring":"fire","mastery":4,"instructions":"Fire 4 kata. Toggle on when active. See description for effects."}}}],"sort":800000,"ownership":{"default":0},"flags":{}}
{"_id":"kat0009","name":"Hidden Blade Style","type":"kata","img":"systems/l5r4-enhanced/assets/icons/kata.webp","folder":"L5R4 Enhanced/Advanced Abilities/Kata","system":{"description":"Air 4 kata. Bayushi Bushi, Yoritomo Bushi. [CR p.176]","specialRules":"Your Disarm attacks deal normal damage rather than 2k1. You may not increase your damage on these attacks via Raises (including from use of the Feint Maneuver).","ring":"air","mastery":4,"schools":["Bayushi Bushi","Yoritomo Bushi"],"cost":4},"effects":[{"name":"Hidden Blade Style (Activate)","icon":"systems/l5r4-enhanced/assets/icons/kata.webp","disabled":true,"transfer":true,"changes":[],"flags":{"l5r4-enhanced":{"template":true,"toggleable":true,"ring":"air","mastery":4,"instructions":"Air 4 kata. Toggle on when active. See description for effects."}}}],"sort":900000,"ownership":{"default":0},"flags":{}}
