{{!-- A conforming template: one root block, localized text, named icon-only controls --}}
<section class="l5r4-sample">
  <span class="l5r4-sample-value -compact">{{value}}</span>
  <button
    type="button"
    class="l5r4-sample-button"
    data-action="delete-item"
    data-tooltip="{{localize "l5r4.ui.common.delete"}}"
    aria-label="{{localize "l5r4.ui.common.delete"}}"
  >
    <i class="fa-solid fa-trash" inert></i>
  </button>
  <button type="button" class="l5r4-sample-button" data-action="expand-section" aria-expanded="true">
    <i class="fa-solid fa-angle-down" inert></i> {{localize "l5r4.ui.common.expand"}}
  </button>
  <button
    type="button"
    class="l5r4-sample-button inline-control icon"
    data-action="edit-item"
    data-tooltip="{{localize "l5r4.ui.common.edit"}}"
    aria-label="{{localize "l5r4.ui.common.edit"}}"
  >
    <i class="fa-solid fa-pen-to-square" inert></i>
  </button>
  <p class="l5r4-sample-note flex0 hint draggable">{{localize "l5r4.ui.common.none"}}</p>
  <img class="l5r4-sample-icon" src="{{img}}" alt="" />
  <img class="l5r4-sample-portrait" src="{{img}}" data-action="editImage" data-edit="img" alt="{{name}}" />
  <input class="l5r4-sample-search" name="search" placeholder="{{localize "l5r4.ui.common.search"}}" />
  <label class="l5r4-sample-label">{{localize "l5r4.ui.check.rollModifier"}}</label>
  <span class="l5r4-sample-slot" data-tooltip="{{localize "l5r4.ui.sheets.spellSlotsOf" ring=(localize "l5r4.ui.mechanics.rings.water") count=count}}">{{count}}</span>
  <p class="l5r4-sample-note">{{#if free}}{{localize "l5r4.ui.common.free"}}{{else}}{{localize "l5r4.ui.common.rank"}}{{/if}}</p>
  <p class="l5r4-sample-note">
    <span>{{localize "l5r4.ui.check.outcomeAgainstTn" outcome=outcome tn=tn}}</span>
    {{#if raises}}<span>{{localize "l5r4.ui.check.raisesNote" count=raises}}</span>{{/if}}
  </p>
  {{> "systems/l5r4-enhanced/templates/apps/_partials/_row.hbs" item=this label=(localize "l5r4.ui.common.roll") tooltip=(localize "l5r4.ui.common.modifier")}}
  {{> (concat "systems/l5r4-enhanced/templates/item/_type-details/" type ".hbs")}}
</section>
