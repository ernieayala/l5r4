<!-- An HTML comment ships into the DOM -->
<div class="sample">
  <span style="color: red" onclick="go()" title="Tip">Plain text</span>
  <span class="-compact">{{value}}</span>
  <span data-action="roll-trait">{{value}}</span>
  <button type="button" data-action="delete-item"><i class="fas fa-edit"></i></button>
  <a data-action="expand-section"><i class="fa-solid fa-angle-down" inert></i></a>
  <img src="{{img}}" />
  <input placeholder="Search" />
  <label>{{localize "l5r4.ui.common.roll"}} {{localize "l5r4.ui.common.modifier"}}</label>
  <span data-tooltip="{{localize (concat "l5r4.ui.mechanics.rings." ring)}} ({{localize "l5r4.ui.hints.postToChat"}})">{{count}}</span>
  <p>{{#if free}}{{localize "l5r4.ui.common.free"}} {{/if}}{{concat (localize "l5r4.ui.common.rank") ":"}}</p>
  {{> controls}}
  <script></script>
</div>
