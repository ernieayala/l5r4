<div class="l5r4-item-details">
  {{> "systems/l5r4-enhanced/templates/item/_partials/_advantage-details.hbs" system=system config=config}}
  {{#if (eq system.type "ancestor")}}
    <div class="form-group">
      <label>{{localize "l5r4.ui.common.clan"}}</label>
      <div class="form-fields">
        <input name="system.clan" type="text" value="{{system.clan}}" data-type="String" />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "l5r4.ui.sheets.demands"}}</label>
      <div class="form-fields">
        {{#if editable}}
          <prose-mirror name="system.demands" value="{{ system.demands }}" document-uuid="{{ item.uuid }}" compact>
            {{{ enriched.demands }}}
          </prose-mirror>
        {{else}}
          <div class="editor editor-content">
            {{{ enriched.demands }}}
          </div>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>
