<div class="l5r4-item-details">
  <div class="form-group">
    <label>{{localize "l5r4.ui.check.schoolRank"}}</label>
    <div class="form-fields">
      <input name="system.rank" type="number" value="{{system.rank}}" data-type="Number" min="0" />
    </div>
    <p class="hint">{{localize "l5r4.ui.check.schoolRankHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.magic.spells.shugenjaSchool"}}</label>
    <div class="form-fields">
      <input name="system.shugenja" type="checkbox" {{checked system.shugenja}} />
    </div>
    <p class="hint">{{localize "l5r4.magic.spells.shugenjaSchoolHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.magic.kiho.startingKiho"}}</label>
    <div class="form-fields">
      <input name="system.kiho" type="number" value="{{system.kiho}}" data-type="Number" min="0" />
    </div>
    <p class="hint">{{localize "l5r4.magic.kiho.startingKihoHint"}}</p>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.magic.kiho.access.label"}}</label>
    <div class="form-fields">
      <select name="system.kihoAccess">
        {{selectOptions config.kihoAccess selected=system.kihoAccess blank="l5r4.magic.kiho.access.auto" localize=true}}
      </select>
    </div>
    <p class="hint">{{localize "l5r4.magic.kiho.accessHint"}}</p>
  </div>
</div>
