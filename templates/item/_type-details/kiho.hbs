<div class="l5r4-item-details">
  {{> "systems/l5r4-enhanced/templates/item/_partials/_mastery-details.hbs" system=system config=config}}
  <div class="form-group">
    <label>{{localize "l5r4.ui.common.type"}}</label>
    <div class="form-fields">
      <select name="system.type">
        {{selectOptions config.kihoTypes selected=system.type localize=true}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.magic.kiho.schoolKiho"}}</label>
    <div class="form-fields">
      <input name="system.schoolKiho" type="checkbox" {{checked system.schoolKiho}} />
    </div>
    <p class="hint">{{localize "l5r4.magic.kiho.schoolKihoHint"}}</p>
  </div>
</div>
