<section class="standard-form">
  <div class="form-group">
    <label>{{localize "l5r4.equipment.keywords"}}</label>
    <div class="form-fields">
      <input name="system.keywords" type="text" value="{{system.keywords}}" placeholder="{{localize 'l5r4.equipment.keywordsPlaceholder'}}" />
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.equipment.nemuranai"}}</label>
    <div class="form-fields">
      <input name="system.nemuranai" type="checkbox" {{checked system.nemuranai}} data-type="Boolean" />
    </div>
  </div>
  <fieldset class="form-group price-section">
    <legend>{{localize "l5r4.equipment.price"}}</legend>
    <div class="form-fields">
      <div class="price-field">
        <label>{{localize "l5r4.world.wealth.koku"}}</label>
        <input name="system.price.koku" type="number" value="{{system.price.koku}}" data-type="Number" min="0" />
      </div>
      <div class="price-field">
        <label>{{localize "l5r4.world.wealth.bu"}}</label>
        <input name="system.price.bu" type="number" value="{{system.price.bu}}" data-type="Number" min="0" />
      </div>
      <div class="price-field">
        <label>{{localize "l5r4.world.wealth.zeni"}}</label>
        <input name="system.price.zeni" type="number" value="{{system.price.zeni}}" data-type="Number" min="0" />
      </div>
    </div>
  </fieldset>
</section>