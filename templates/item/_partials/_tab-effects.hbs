<section class="l5r4-section tab {{#if (eq currentTab "effects")}}active{{/if}}" role="tabpanel" data-tab="effects" data-application-part="effects">
  {{!-- Active Effects Management --}}
  <div>
    {{#if editable}}
      <button type="button" data-action="create-effect">
        <i class="fa-solid fa-plus" inert></i> {{localize "l5r4.ui.common.new"}}
      </button>
    {{/if}}

    <ol class="l5r4-effect-list">
      {{#each effects as |e|}}
        <li class="flexrow -gap-sm l5r4-effect-list-row" data-effect-id="{{e.id}}">
          <div class="flex1 l5r4-effect-list-name">
            {{#if e.label}}{{e.label}}{{else}}{{e.name}}{{/if}}
            {{#if e.disabled}}<em>({{localize "l5r4.ui.common.disabled"}})</em>{{/if}}
          </div>
          <div class="flexrow -gap-md flex0 l5r4-inline-control">
            <button type="button" class="l5r4-effect-list-button" data-action="edit-effect" data-tooltip="{{localize "l5r4.ui.common.edit"}}" aria-label="{{localize "l5r4.ui.common.edit"}}"><i class="fa-solid fa-pen-to-square" inert></i></button>
            <button type="button" class="l5r4-effect-list-button" data-action="toggle-effect" aria-pressed="{{#if e.disabled}}false{{else}}true{{/if}}" data-tooltip="{{localize "l5r4.ui.common.toggle"}}" aria-label="{{localize "l5r4.ui.common.toggle"}}">
              <i class="fa-solid {{#if e.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" inert></i>
            </button>
            <button type="button" class="l5r4-effect-list-button" data-action="delete-effect" data-tooltip="{{localize "l5r4.ui.common.delete"}}" aria-label="{{localize "l5r4.ui.common.delete"}}"><i class="fa-solid fa-trash" inert></i></button>
          </div>
        </li>
      {{/each}}
    </ol>
  </div>
</section>
