{{!-- The details a kata and a kiho share: the Ring and the Mastery Level. Parameters: system, config (the item
sheet context). --}}
<div class="l5r4-item-details">
  <div class="form-group">
    <label>{{localize "l5r4.ui.common.ring"}}</label>
    <div class="form-fields">
      <select name="system.ring">
        {{selectOptions config.rings selected=system.ring localize=true}}
      </select>
    </div>
  </div>
  <div class="form-group">
    <label>{{localize "l5r4.ui.sheets.mastery"}}</label>
    <div class="form-fields">
      <input name="system.mastery" type="number" value="{{system.mastery}}" data-type="Number" />
    </div>
    <p class="hint">{{localize "l5r4.ui.sheets.masteryHint"}}</p>
  </div>
</div>
