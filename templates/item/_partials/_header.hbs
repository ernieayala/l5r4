<header class="flexrow -gap-md l5r4-item-header">
  <img class="flex0 l5r4-item-header-image" src="{{item.img}}" data-edit="img" data-action="editImage" data-tooltip="{{item.name}}" alt="{{item.name}}"/>
  <div class="l5r4-item-header-fields">
    <h1 class="l5r4-item-header-name">
      <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'l5r4.ui.common.name'}}"/>
    </h1>
    {{#if summary.citation}}
      <p class="l5r4-citation">{{summary.citation}}</p>
    {{/if}}
  </div>
</header>
