<fieldset class="l5r4-check-dialog-group">
  <legend>{{localize "l5r4.ui.mechanics.rolls.spellCasting"}}</legend>
  <div class="form-group">
    <label for="{{formId}}-spell-casting">{{localize "l5r4.ui.check.castSpell"}}</label>
    <input type="checkbox" id="{{formId}}-spell-casting" name="spellCasting" />
  </div>
  <div class="form-group">
    <label for="{{formId}}-affinity">{{localize "l5r4.magic.spells.affinity"}}</label>
    <input type="checkbox" id="{{formId}}-affinity" name="affinity" {{checked affinity}} />
  </div>
  <div class="form-group">
    <label for="{{formId}}-deficiency">{{localize "l5r4.magic.spells.deficiency"}}</label>
    <input type="checkbox" id="{{formId}}-deficiency" name="deficiency" {{checked deficiency}} />
  </div>
  {{> "systems/l5r4-enhanced/templates/dialogs/check-extras/slot.hbs"}}
  {{!-- Shown while a cast is ticked that the School Rank cannot make; Roll waits until it can (#141) --}}
  <p class="l5r4-check-dialog-warning" role="note" data-casting-blocked hidden>
    <i class="l5r4-check-dialog-warning-icon fa-solid fa-triangle-exclamation" inert></i>
    <span data-casting-blocked-text></span>
  </p>
</fieldset>
