<div class="l5r4-check-dialog-slot form-group">
  <label for="{{formId}}-slot">{{localize "l5r4.ui.check.spellSlot"}}</label>
  {{!-- A slot type with none left cannot be picked; its count shows why (#141) --}}
  <select id="{{formId}}-slot" name="slot">
    <option value="elemental" {{#if (eq slot "elemental")}}selected{{/if}} {{disabled (not elementalSlots)}}>
      {{localize "l5r4.magic.spells.useSpellSlot"}} {{ringName}} ({{elementalSlots}})
    </option>
    <option value="void" {{#if (eq slot "void")}}selected{{/if}} {{disabled (not voidSlots)}}>
      {{localize "l5r4.magic.spells.voidSlot"}} ({{voidSlots}})
    </option>
    <option value="none" {{#if (eq slot "none")}}selected{{/if}}>{{localize "l5r4.ui.common.none"}}</option>
  </select>
</div>
