<div class="chat-card l5r4-roll l5r4-check">
  <div class="dice-flavor">
    {{#if target.name}}{{localize "l5r4.ui.check.titleAgainst" label=label target=target.name}}{{else}}{{label}}{{/if}}
  </div>
  {{#if appliedModifiers.length}}
    <ul class="check-applied">
      {{#each appliedModifiers}}<li>{{label}} {{text}}</li>{{/each}}
    </ul>
  {{/if}}
  {{{roll}}}
  {{#if tn}}
    <div class="l5r4-tn-result">
      <span>{{localize "l5r4.ui.check.outcomeAgainstTn" outcome=outcomeText tn=tn.effective}}</span>
      {{#if tn.raises}}<span>{{localize "l5r4.ui.check.raisesNote" count=tn.raises}}</span>{{/if}}
      {{#if tn.freeRaisesToTN}}<span>{{localize "l5r4.ui.check.freeRaisesToTnNote" count=tn.freeRaisesToTN}}</span>{{/if}}
      {{#if tn.woundPenalty}}<span>{{localize "l5r4.ui.check.woundPenaltyNote" penalty=tn.woundPenalty}}</span>{{/if}}
      {{!-- Every TN change the roll kept, those ticked in the dialog included (decision 17, #115) --}}
      {{#if tnChanges}}<span>{{tnChanges}}</span>{{/if}}
    </div>
  {{/if}}
  {{#if raisesWithoutTn}}
    <div class="check-note">{{localize "l5r4.ui.check.raisesNote" count=raisesWithoutTn}}</div>
  {{/if}}
  {{#if freeRaisesLeft}}
    <div class="check-free-raises">{{localize "l5r4.ui.check.freeRaisesLeft" count=freeRaisesLeft}}</div>
  {{/if}}
  {{#each notes}}<div class="check-note">{{this}}</div>{{/each}}
  {{#each maneuverNotes}}<div class="check-note">{{this}}</div>{{/each}}
  {{#if sources.length}}
    <div class="check-note">{{localize "l5r4.ui.combat.sources" sources=(join sources)}}</div>
  {{/if}}
  {{#if contest}}
    <button type="button" data-action="combat-contest">{{localize "l5r4.ui.combat.contestStrength"}}</button>
  {{/if}}
  {{#if grappleButton}}
    <button type="button" data-action="grapple-start">
      {{localize "l5r4.ui.combat.grappleStart" target=target.name}}
    </button>
  {{/if}}
  {{#if (eq kind "damage")}}
    <div class="damage-actions flexrow -gap-sm">
      {{#if applyTarget}}
        <button type="button" data-action="damage-apply-target">
          {{localize "l5r4.ui.combat.applyTo" target=applyTarget}}
        </button>
      {{/if}}
      <button type="button" data-action="damage-apply-selected">
        {{localize "l5r4.ui.combat.applySelected"}}
      </button>
    </div>
  {{/if}}
  {{#if (and (eq outcome.success true) conditions.length)}}
    <div class="check-conditions flexrow -gap-sm">
      {{#each conditions}}
        <button type="button" data-action="apply-condition" data-index="{{@index}}">
          {{localize "l5r4.ui.effects.applyTo" effect=label target=../target.name}}
        </button>
      {{/each}}
    </div>
  {{/if}}
  {{#if damageButton}}
    <button type="button" class="l5r4-check-damage" data-action="check-damage">
      {{localize "l5r4.ui.check.damageRollPool" pool=damageButton}}
    </button>
  {{/if}}
  {{#if honorRoll}}
    <button type="button" data-action="honor-roll">{{localize "l5r4.ui.honorRoll.button"}}</button>
  {{/if}}
</div>
