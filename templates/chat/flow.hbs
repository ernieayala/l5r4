<div class="chat-card l5r4-flow-card">
  <div class="dice-flavor">{{localize "l5r4.ui.combat.flowTitle" flow=title stage=stage}}</div>
  {{#each lines}}<div class="check-note">{{this}}</div>{{/each}}
  {{#if buttons.length}}
    <div class="flow-actions flexrow -gap-sm">
      {{#each buttons}}
        <button type="button" data-flow-action="{{action}}" data-duelist="{{data}}" data-side="{{data}}">{{label}}</button>
      {{/each}}
    </div>
  {{/if}}
  {{#if (or gm.redo gm.end)}}
    <div class="flow-actions flexrow -gap-sm">
      {{#if gm.redo}}<button type="button" data-flow-gm="redo">{{localize "l5r4.ui.combat.flowRedo"}}</button>{{/if}}
      {{#if gm.end}}<button type="button" data-flow-gm="end">{{#if gm.endLabel}}{{gm.endLabel}}{{else}}{{localize "l5r4.ui.combat.flowEnd"}}{{/if}}</button>{{/if}}
    </div>
  {{/if}}
</div>
