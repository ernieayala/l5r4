<div class="chat-card healing-card l5r4-healing-card">
  <div class="dice-flavor">{{localize "l5r4.ui.mechanics.wounds.restTitle" name=actorName}}</div>
  <div class="card-content">
    <p>{{healingText}}</p>
    <p>{{woundsText}}</p>
    {{#if wasFullyHealed}}
      <p><strong>{{localize "l5r4.ui.mechanics.wounds.fullyHealed"}}</strong></p>
    {{/if}}
    {{#if spellSlotsRestored}}
      <p><em>{{localize "l5r4.magic.spells.slotsRestored"}}</em></p>
    {{/if}}
    {{#if voidRestored}}
      <p><em>{{localize "l5r4.ui.mechanics.wounds.voidRestored" count=voidRestored}}</em></p>
    {{/if}}
  </div>
</div>
