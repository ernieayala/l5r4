{{#if (or lines.length citation)}}
  <div class="l5r4-item-summary">
    {{#if lines.length}}
      <ul class="l5r4-rule-lines">
        {{#each lines}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    {{/if}}
    {{#if citation}}
      <p class="l5r4-citation">{{citation}}</p>
    {{/if}}
  </div>
{{/if}}
