<div class="item l5r4-item-row -{{type}}{{#if (or system.description system.specialRules system.reachedMasteries.length)}} -expandable{{/if}}{{#if inSheet}} draggable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">
    {{#if inSheet}}
      {{name}}
      {{#if system.school}}
        <span class="l5r4-item-row-badge" role="img" aria-label="{{localize "l5r4.character.skills.properties.school"}}"></span>
      {{/if}}
    {{else}}
      {{name}}
    {{/if}}
  </h4>
  {{#if inSheet}}
    <div class="l5r4-item-row-cell">{{system.rank}}</div>
    <div class="l5r4-item-row-cell">
      <select
        data-action="update-item-field"
        data-field="system.trait"
        data-type="String"
        aria-label="{{localize "l5r4.character.skills.properties.trait"}}"
        {{!-- The full Trait where a translation is longer than the column (#161) --}}
        data-tooltip="{{localize (lookup @root.config.traits system.trait)}}"
      >
        {{selectOptions @root.config.traits selected=system.trait localize=true}}
      </select>
    </div>
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_roll-button.hbs" action="roll-skill" pool=system.rollFormula tooltip=(localize "l5r4.ui.mechanics.rolls.skillRoll")}}
    <div class="l5r4-item-row-emphases">
      {{#if system.trainedEmphases.length}}
        {{join system.trainedEmphases ", "}}
      {{else}}
        —
      {{/if}}
    </div>
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs" expandable=(or system.description system.specialRules system.reachedMasteries.length)}}
    {{#if (or system.description system.specialRules system.reachedMasteries.length)}}
      <div class="l5r4-item-row-details">
        {{#each system.reachedMasteries}}
          <p><strong>{{localize (concat "l5r4.character.skills.properties." field)}}:</strong> {{text}}</p>
        {{/each}}
        {{> "systems/l5r4-enhanced/templates/cards/_partials/_detail-text.hbs" rules=system.specialRules description=system.description}}
      </div>
    {{/if}}
  {{/if}}
  {{#unless inSheet}}
    <p><strong>{{localize "l5r4.character.skills.properties.trait"}}:</strong> {{localize (concat "l5r4.ui.mechanics.traits." system.trait)}}</p>
    <p><strong>{{localize "l5r4.character.skills.properties.type"}}:</strong> {{localize (concat "l5r4.character.skillTypes." system.type)}}</p>
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
    {{#if (gte system.rank 3)}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.character.skills.properties.mastery3" text=system.mastery3}}
    {{/if}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.character.skills.properties.mastery5" text=system.mastery5}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.character.skills.properties.mastery7" text=system.mastery7}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
