<div class="item l5r4-item-row -{{type}}{{#if (or system.description system.specialRules)}} -expandable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    <div class="l5r4-item-row-cell">{{system.effect}}</div>
    {{#unless system.passive}}
      {{> "systems/l5r4-enhanced/templates/cards/_partials/_activate.hbs"}}
    {{/unless}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs"}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" rules=system.specialRules description=system.description}}
  {{/if}}
  {{#unless inSheet}}
    {{#if system.effect}}
      <h5>{{localize "l5r4.ui.common.effect"}}</h5>
      <p>
        {{system.effect}}
      </p>
    {{/if}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
