<div class="item l5r4-item-row -{{type}}{{#if (or system.description system.specialRules)}} -expandable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}"
  data-document-type="Item"
  draggable="{{@root.editable}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    {{#unless system.shugenja}}
      <div><strong>{{localize "l5r4.ui.common.rank"}}:</strong> {{system.rank}}</div>
      <span></span>
    {{/unless}}
    {{#if system.shugenja}}
      {{#if system.affinity}}
      <div><strong>{{localize "l5r4.magic.spells.affinity"}}:</strong> {{localize (concat "l5r4.ui.mechanics.rings." system.affinity)}}</div>
      {{/if}}
      {{#if system.deficiency}}
      <div><strong>{{localize "l5r4.magic.spells.deficiency"}}:</strong> {{localize (concat "l5r4.ui.mechanics.rings." system.deficiency)}}</div>
      {{/if}}
    {{/if}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs"}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" rules=system.specialRules description=system.description}}
  {{/if}}
  {{#unless inSheet}}
    {{#unless system.shugenja}}
      <p><strong>{{localize "l5r4.ui.common.rank"}}:</strong> {{system.rank}}</p>
    {{/unless}}
    {{#if system.shugenja}}
      {{#if system.affinity}}
      <p><strong>{{localize "l5r4.magic.spells.affinity"}}:</strong> {{localize (concat "l5r4.ui.mechanics.rings." system.affinity)}}</p>
      {{/if}}
      {{#if system.deficiency}}
      <p><strong>{{localize "l5r4.magic.spells.deficiency"}}:</strong> {{localize (concat "l5r4.ui.mechanics.rings." system.deficiency)}}</p>
      {{/if}}
    {{/if}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
