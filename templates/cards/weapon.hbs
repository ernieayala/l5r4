<div class="item l5r4-item-row -{{type}}{{#if system.description}} -expandable{{/if}}{{#if inSheet}} draggable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    <div class="l5r4-button -roll">
      <span class="l5r4-button-under">{{attackFormula}}</span>
      <a class="button" data-action="roll-weapon-attack" title="{{localize "l5r4.ui.mechanics.rolls.attackRoll"}}">{{attackFormula}}</a>
    </div>
    <div class="l5r4-button -roll">
      <span class="l5r4-button-under">{{#if system.derivedDamageFormula}}{{system.derivedDamageFormula}}{{else}}{{system.damageRoll}}k{{system.damageKeep}}{{/if}}</span>
      <a class="button" data-action="roll-weapon-damage" title="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">{{#if system.derivedDamageFormula}}{{system.derivedDamageFormula}}{{else}}{{system.damageRoll}}k{{system.damageKeep}}{{/if}}</a>
    </div>
    {{#if ranged}}
        <select data-action="update-item-field" data-field="system.arrow">{{selectOptions @root.config.arrows selected=system.arrow localize=true}}</select>
    {{/if}}
    {{#unless ranged}}
      <span></span>
    {{/unless}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs"}}
    {{#if system.description}}
      <div class="l5r4-item-row-details">
        <p>{{{system.description}}}</p>
      </div>
    {{/if}}
  {{/if}}
  {{#unless inSheet}}
    <p><strong>{{localize "l5r4.ui.common.damage"}}:</strong> {{system.damageRoll}}k{{system.damageKeep}}</p>
    {{#if ranged}}
      <p><strong> {{localize "l5r4.ui.mechanics.traits.str"}}:</strong> {{system.str}}</p>
    {{/if}}
    {{#if system.specialRules}}
      <h5>{{localize "l5r4.ui.sheets.rulesSummary"}}</h5>
      <p>
        {{{system.specialRules}}}
      </p>
    {{/if}}
    {{#if system.description}}
      <h5>{{localize "l5r4.ui.sheets.description"}}</h5>
      <p>
        {{{system.description}}}
      </p>
    {{/if}}
  {{/unless}}
</div>
