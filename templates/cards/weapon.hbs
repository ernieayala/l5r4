<div class="item l5r4-item-row -{{type}}{{#if system.description}} -expandable{{/if}}{{#if inSheet}} draggable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_roll-button.hbs" action="roll-weapon-attack" pool=attackFormula tooltip=(localize "l5r4.ui.mechanics.rolls.attackRoll")}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_roll-button.hbs" action="roll-weapon-damage" pool=system.derivedDamageFormula tooltip=(localize "l5r4.ui.mechanics.rolls.damageRoll")}}
    <div class="l5r4-item-row-cell">
      {{#if ranged}}
        <select
          data-action="update-item-field"
          data-field="system.arrow"
          aria-label="{{localize "l5r4.equipment.weapons.arrow"}}"
        >{{selectOptions @root.config.arrows selected=system.arrow localize=true}}</select>
      {{/if}}
    </div>
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs" expandable=system.description}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" description=system.description}}
  {{/if}}
  {{#unless inSheet}}
    <p><strong>{{localize "l5r4.ui.common.damage"}}:</strong> {{system.damageRoll}}k{{system.damageKeep}}</p>
    {{#if ranged}}
      <p><strong> {{localize "l5r4.ui.mechanics.traits.str"}}:</strong> {{system.str}}</p>
    {{/if}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
