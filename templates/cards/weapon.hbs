<div class="item l5r4-item-row -{{type}}{{#if system.description}} -expandable{{/if}}{{#if inSheet}} draggable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    <div class="l5r4-button -roll">
      <span class="l5r4-button-under">{{attackFormula}}</span>
      <button type="button" class="l5r4-button-face" data-action="roll-weapon-attack" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.attackRoll"}}">{{attackFormula}}</button>
    </div>
    <div class="l5r4-button -roll">
      <span class="l5r4-button-under">{{#if system.derivedDamageFormula}}{{system.derivedDamageFormula}}{{else}}{{system.damageRoll}}k{{system.damageKeep}}{{/if}}</span>
      <button type="button" class="l5r4-button-face" data-action="roll-weapon-damage" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">{{#if system.derivedDamageFormula}}{{system.derivedDamageFormula}}{{else}}{{system.damageRoll}}k{{system.damageKeep}}{{/if}}</button>
    </div>
    {{#if ranged}}
        <select data-action="update-item-field" data-field="system.arrow">{{selectOptions @root.config.arrows selected=system.arrow localize=true}}</select>
    {{/if}}
    {{#unless ranged}}
      <span></span>
    {{/unless}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs"}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" description=system.description}}
  {{/if}}
  {{#unless inSheet}}
    <p><strong>{{localize "l5r4.ui.common.damage"}}:</strong> {{system.damageRoll}}k{{system.damageKeep}}</p>
    {{#if ranged}}
      <p><strong> {{localize "l5r4.ui.mechanics.traits.str"}}:</strong> {{system.str}}</p>
    {{/if}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
