{{!-- A Clan, Family, or School card (item-row.md, Bio variant): the same row in the Bio section and in chat, where
it posts as its name. Parameters: the item card context (name, system, docId, inSheet). --}}
<div class="item l5r4-item-row -bio{{#if system.description}} -expandable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs" expandable=system.description}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" description=system.description}}
  {{/if}}
</div>
