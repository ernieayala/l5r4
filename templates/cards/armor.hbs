<div class="item l5r4-item-row -{{type}}{{#if system.description}} -expandable{{/if}}"
  data-item-id="{{coalesce docId this.id _id}}"
  data-document-id="{{coalesce docId this.id _id}}">
  <h4 class="flexrow -gap-sm title">{{name}}</h4>
  {{#if inSheet}}
    <div>{{system.bonus}}</div>
    <div>{{system.reduction}}</div>
    <div><input data-action="update-item-field" data-field="system.equipped" type="checkbox" {{checked system.equipped}} data-dtype="Boolean" /></div>
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs"}}
    {{> "systems/l5r4-enhanced/templates/cards/_partials/_details.hbs" description=system.description}}
  {{/if}}
  {{#unless inSheet}}
    <p><strong>{{localize "l5r4.ui.common.bonus"}}:</strong> {{system.bonus}}</p>
    <p><strong>{{localize "l5r4.equipment.armor.reduction"}}:</strong> {{system.reduction}}</p>
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.rulesSummary" text=system.specialRules}}
{{> "systems/l5r4-enhanced/templates/cards/_partials/_text-section.hbs" label="l5r4.ui.sheets.description" text=system.description}}
  {{/unless}}
</div>
