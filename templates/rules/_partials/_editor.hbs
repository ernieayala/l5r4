{{!-- The rules editor (module/sheets/rules-editor.js): a form per rule, or the list as JSON --}}
<div class="l5r4-rules-editor flexcol -gap-sm" data-rules-editor>
  <div class="l5r4-rules-editor-toolbar flexrow -gap-sm">
    <p class="hint">{{localize "l5r4.ui.rules.hint"}}</p>
    {{#if rulesEditable}}
      <button type="button" class="l5r4-rules-editor-mode" data-action="toggle-rules-view">
        {{localize (ifThen (eq rulesMode "json") "l5r4.ui.rules.formView" "l5r4.ui.rules.jsonView")}}
      </button>
    {{/if}}
  </div>

  {{#if (eq rulesMode "json")}}
    <textarea class="l5r4-rules-editor-json" name="rulesJson" rows="16" spellcheck="false" {{disabled (not rulesEditable)}}>{{rulesJson}}</textarea>
  {{else}}
    {{#each rules as |rule|}}
      <fieldset class="l5r4-rules-editor-card" data-rule-index="{{rule.index}}">
        <legend>
          {{rule.key}}
          {{#if @root.rulesEditable}}
            <button type="button" class="l5r4-rules-editor-delete" data-action="delete-rule" data-tooltip="{{localize "l5r4.ui.rules.delete"}}" aria-label="{{localize "l5r4.ui.rules.delete"}}">
              <i class="fa-solid fa-trash" inert></i>
            </button>
          {{/if}}
        </legend>
        {{#if rule.error}}
          <p class="l5r4-rules-editor-error" id="{{@root.formId}}-rule-{{rule.index}}-error" data-rule-error>
            <i class="fa-solid fa-circle-exclamation" inert></i>
            {{rule.error}}
          </p>
        {{/if}}
        {{#each rule.fields as |field|}}
          <div class="form-group l5r4-rules-editor-field" data-kind="{{field.kind}}">
            <label>{{field.name}}</label>
            {{!-- An invalid rule's fields point at its error line (foundations/states.md rule 7) --}}
            {{#if (eq field.kind "boolean")}}
              <input type="checkbox" name="rules.{{rule.index}}.{{field.name}}" {{checked field.value}} {{disabled (not @root.rulesEditable)}} {{#if rule.error}}aria-invalid="true" aria-describedby="{{@root.formId}}-rule-{{rule.index}}-error"{{/if}} />
            {{else if (eq field.kind "number")}}
              <input type="number" name="rules.{{rule.index}}.{{field.name}}" value="{{field.value}}" {{disabled (not @root.rulesEditable)}} {{#if rule.error}}aria-invalid="true" aria-describedby="{{@root.formId}}-rule-{{rule.index}}-error"{{/if}} />
            {{else if (eq field.kind "select")}}
              <select name="rules.{{rule.index}}.{{field.name}}" {{disabled (not @root.rulesEditable)}} {{#if rule.error}}aria-invalid="true" aria-describedby="{{@root.formId}}-rule-{{rule.index}}-error"{{/if}}>
                {{#if field.nullable}}<option value=""></option>{{/if}}
                {{selectOptions field.choices selected=field.value}}
              </select>
            {{else if (eq field.kind "json")}}
              <textarea name="rules.{{rule.index}}.{{field.name}}" rows="2" spellcheck="false" {{disabled (not @root.rulesEditable)}} {{#if rule.error}}aria-invalid="true" aria-describedby="{{@root.formId}}-rule-{{rule.index}}-error"{{/if}}>{{field.value}}</textarea>
            {{else}}
              <input type="text" name="rules.{{rule.index}}.{{field.name}}" value="{{field.value}}" {{disabled (not @root.rulesEditable)}} {{#if rule.error}}aria-invalid="true" aria-describedby="{{@root.formId}}-rule-{{rule.index}}-error"{{/if}} />
            {{/if}}
          </div>
        {{/each}}
      </fieldset>
    {{else}}
      <p class="l5r4-rules-editor-empty">{{localize "l5r4.ui.rules.none"}}</p>
    {{/each}}
    {{#if rulesEditable}}
      <div class="l5r4-rules-editor-add flexrow -gap-sm">
        <select data-rule-key aria-label="{{localize "l5r4.ui.rules.key"}}">{{selectOptions ruleKeys}}</select>
        <button type="button" data-action="create-rule">
          <i class="fa-solid fa-plus" inert></i> {{localize "l5r4.ui.rules.add"}}
        </button>
      </div>
    {{/if}}
  {{/if}}
</div>
