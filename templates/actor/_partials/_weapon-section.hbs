<section class="l5r4-section flexcol -gap-sm">
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" scope="weapons" label="l5r4.ui.sheets.weapons" collapsed=collapsedSections.weapons create=true expand=true}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="weapons" type="weapon" columns=@root.sortColumns.weapons sort=@root.sortState.weapons}}
  <section class="l5r4-item-row-list -weapon" data-scope="weapons">
    {{#each weapons as |weapon id|}}
      {{> "systems/l5r4-enhanced/templates/cards/weapon.hbs"
          system=weapon.system
          inSheet=true
          docId=weapon.id}}
    {{/each}}
  </section>
</section>
