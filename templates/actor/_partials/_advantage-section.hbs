<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.advantages}} is-collapsed{{/if}}" data-section-title data-scope="advantages">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.advantages"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.advantages}}
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="advantages" type="advantage" columns=@root.sortColumns.advantages sort=@root.sortState.advantages}}
  <section class="l5r4-item-row-list -advantage">
    {{#each advantages as |item id|}}
      {{> "systems/l5r4-enhanced/templates/cards/advantage-disadvantage.hbs"
          system=item.system
          inSheet=true
          docId=item.id}}
    {{/each}}
  </section>
</section>
