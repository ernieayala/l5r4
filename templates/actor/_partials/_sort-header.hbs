{{!-- The column header row over an item list (sort-header.md). Parameters: type (the list's -<type> column set, as
item-row.md names it), columns (the list's heads from SORT_COLUMNS, module/config/sort-keys.js: a head with a key
sorts and is a button, one with only a label is plain text, an empty one is the spacer over the controls column),
scope (the list's sort scope, its data-scope; left out for a list whose heads do not sort), sort (the list's stored
sort, { key, dir }, from getSortPrefs in module/services/sort-preferences.js; left out with scope). --}}
<section class="l5r4-item-row-list -{{type}} l5r4-sort-header" data-sort-header{{#if scope}} data-scope="{{scope}}"{{/if}}>
  <div class="l5r4-item-row">
    {{#each columns}}
      {{#if key}}
        {{#if (eq ../sort.key key)}}
          <button
            type="button"
            class="l5r4-sort-header-button is-active"
            data-action="sort-items"
            data-sort-by="{{key}}"
            data-dir="{{../sort.dir}}"
            aria-pressed="true"
            {{#if (eq ../sort.dir "desc")}}
              data-tooltip="{{localize "l5r4.ui.common.sortedDescending"}}"
            {{else}}
              data-tooltip="{{localize "l5r4.ui.common.sortedAscending"}}"
            {{/if}}
          >
            {{localize label}}
            {{#if (eq ../sort.dir "desc")}}
              <i class="fa-solid fa-sort-down" inert></i>
            {{else}}
              <i class="fa-solid fa-sort-up" inert></i>
            {{/if}}
          </button>
        {{else}}
          <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sort-by="{{key}}" aria-pressed="false">{{localize label}}</button>
        {{/if}}
      {{else if label}}
        <span class="l5r4-sort-header-label">{{localize label}}</span>
      {{else}}
        <span></span>
      {{/if}}
    {{/each}}
  </div>
</section>
