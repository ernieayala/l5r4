<section class="flexcol -gap-sm l5r4-section -bio">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.bio}} is-collapsed{{/if}}" data-scope="bio">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.background"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.bio}}
  </div>
  <section class="l5r4-item-row-list -bio">
    {{#if bioClan}}
      {{> "systems/l5r4-enhanced/templates/cards/clan.hbs"
          inSheet=true
          name=bioClan.name
          system=bioClan.system
          docId=bioClan.id}}
    {{/if}}
    {{#if bioFamily}}
      {{> "systems/l5r4-enhanced/templates/cards/family.hbs"
          inSheet=true
          name=bioFamily.name
          system=bioFamily.system
          docId=bioFamily.id}}
    {{/if}}
    {{#if bioSchool}}
      {{> "systems/l5r4-enhanced/templates/cards/school.hbs"
          inSheet=true
          name=bioSchool.name
          system=bioSchool.system
          docId=bioSchool.id}}
    {{/if}}
  </section>
</section>
