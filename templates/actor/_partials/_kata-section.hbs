<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.katas}} is-collapsed{{/if}}" data-section-title data-scope="katas">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.kata"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.katas}}
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="katas" type="kata" columns=@root.sortColumns.katas}}
  <section class="l5r4-item-row-list -kata">
    {{#each katas as |kata id|}}
      {{> "systems/l5r4-enhanced/templates/cards/kata.hbs" system=kata.system inSheet=true docId=kata.id active=(includes @root.activeItemIds kata.id)}}
    {{/each}}
  </section>
</section>
