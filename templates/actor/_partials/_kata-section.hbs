<section class="flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.katas}} is-collapsed{{/if}}" data-scope="katas">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.kata"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs"}}
  </div>
  <section class="l5r4-item-row-list -kata l5r4-sort-header" data-scope="katas">
    <div class="l5r4-item-row">
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="ring">{{localize "l5r4.ui.common.ring"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="mastery">{{localize "l5r4.ui.common.mastery"}}</a>
      <span></span>
    </div>
  </section>
  <section class="l5r4-item-row-list -kata">
    {{#each katas as |kata id|}}
      {{> "systems/l5r4-enhanced/templates/cards/kata.hbs" system=kata.system inSheet=true docId=kata.id active=(includes @root.activeItemIds kata.id)}}
    {{/each}}
  </section>
</section>
