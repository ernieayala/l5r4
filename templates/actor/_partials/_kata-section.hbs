<section class="l5r4-section flexcol -gap-sm">
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" scope="katas" label="l5r4.ui.sheets.kata" collapsed=collapsedSections.katas create=true expand=true}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="katas" type="kata" columns=@root.sortColumns.katas sort=@root.sortState.katas}}
  <section class="l5r4-item-row-list -kata">
    {{#each katas as |kata id|}}
      {{> "systems/l5r4-enhanced/templates/cards/kata.hbs" system=kata.system inSheet=true docId=kata.id active=(includes @root.activeItemIds kata.id)}}
    {{/each}}
  </section>
</section>
