<section class="l5r4-ranks">
  <div class="l5r4-rank-control -track">
    <div class="l5r4-rank-control-under">
      <span>{{localize "l5r4.character.ranks.honorRank"}}</span>
      <span>{{system.honor.rank}}.{{system.honor.points}}</span>
    </div>
    <button
      type="button"
      class="flexcol -gap-xs l5r4-rank-control-value"
      data-action="adjust-rank-points"
      data-key="honor"
      data-tooltip="{{localize "l5r4.ui.hints.shiftClickRankPoints"}}"
    >
      <span>{{localize "l5r4.character.ranks.honorRank"}}</span>
      <span>{{system.honor.rank}}.{{system.honor.points}}</span>
    </button>
  </div>
  <div class="l5r4-rank-control -track">
    <div class="l5r4-rank-control-under">
      <span>{{localize "l5r4.character.ranks.gloryRank"}}</span>
      <span>{{system.glory.rank}}.{{system.glory.points}}</span>
    </div>
    <button
      type="button"
      class="flexcol -gap-xs l5r4-rank-control-value"
      data-action="adjust-rank-points"
      data-key="glory"
      data-tooltip="{{localize "l5r4.ui.hints.shiftClickRankPoints"}}"
    >
      <span>{{localize "l5r4.character.ranks.gloryRank"}}</span>
      <span>{{system.glory.rank}}.{{system.glory.points}}</span>
    </button>
  </div>
  <div class="l5r4-rank-control -track">
    <div class="l5r4-rank-control-under">
      <span>{{localize "l5r4.character.ranks.statusRank"}}</span>
      <span>{{system.status.rank}}.{{system.status.points}}</span>
    </div>
    <button
      type="button"
      class="flexcol -gap-xs l5r4-rank-control-value"
      data-action="adjust-rank-points"
      data-key="status"
      data-tooltip="{{localize "l5r4.ui.hints.shiftClickRankPoints"}}"
    >
      <span>{{localize "l5r4.character.ranks.statusRank"}}</span>
      <span>{{system.status.rank}}.{{system.status.points}}</span>
    </button>
  </div>
  <div class="l5r4-rank-control -track">
    <div class="l5r4-rank-control-under">
      <span>{{localize "l5r4.character.ranks.taintRank"}}</span>
      <span>{{system.shadowTaint.rank}}.{{system.shadowTaint.points}}</span>
    </div>
    <button
      type="button"
      class="flexcol -gap-xs l5r4-rank-control-value"
      data-action="adjust-rank-points"
      data-key="shadowTaint"
      data-tooltip="{{localize "l5r4.ui.hints.shiftClickRankPoints"}}"
    >
      <span>{{localize "l5r4.character.ranks.taintRank"}}</span>
      <span>{{system.shadowTaint.rank}}.{{system.shadowTaint.points}}</span>
    </button>
  </div>
  {{#if editable}}
    <a class="l5r4-ranks-ledger" data-action="open-ledger" data-tooltip="{{localize "l5r4.ui.ledger.hint"}}">
      <i class="fa-solid fa-book-bookmark" inert></i> {{localize "l5r4.ui.ledger.title"}}
    </a>
  {{/if}}
</section>