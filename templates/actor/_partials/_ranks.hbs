<section class="l5r4-ranks">
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_rank-track.hbs" track="honor" label="l5r4.character.ranks.honorRank" rank=system.honor.rank points=system.honor.points}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_rank-track.hbs" track="glory" label="l5r4.character.ranks.gloryRank" rank=system.glory.rank points=system.glory.points}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_rank-track.hbs" track="status" label="l5r4.character.ranks.statusRank" rank=system.status.rank points=system.status.points}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_rank-track.hbs" track="shadowTaint" label="l5r4.character.ranks.taintRank" rank=system.shadowTaint.rank points=system.shadowTaint.points}}
  {{#if editable}}
    <button type="button" class="l5r4-ranks-ledger" data-action="open-ledger" data-tooltip="{{localize "l5r4.ui.ledger.hint"}}">
      <i class="fa-solid fa-book-bookmark" inert></i> {{localize "l5r4.ui.ledger.title"}}
    </button>
  {{/if}}
</section>
