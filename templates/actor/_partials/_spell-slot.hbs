{{!-- One Ring's spell slots in the Spells section title (spell-slots.md): the Ring's image with the count over it.
Parameters: ring (water, air, fire, earth, void), count (system.spellSlots.<ring>). --}}
<div class="l5r4-spell-slot">
  <img src="{{iconPath (concat ring ".webp")}}" alt="" data-tooltip="{{localize (concat "l5r4.ui.mechanics.rings." ring)}}" />
  <button
    type="button"
    class="l5r4-spell-slot-count"
    data-action="adjust-spell-slot"
    data-path="system.spellSlots.{{ring}}"
    data-tooltip="{{localize (concat "l5r4.ui.mechanics.rings." ring)}} ({{localize "l5r4.ui.hints.leftRightToAdjust"}})">
    {{count}}
  </button>
</div>
