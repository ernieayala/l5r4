{{!-- One section's title row (patterns/sheets.md rule 1, section.md): the heading, the title's own tools, then the
add and expand controls. Parameters: label (i18n key of the heading), scope (the section's id for its collapsed and
sort state; left out for a section that does not collapse), collapsed (collapsedSections.<scope>), create (the add
control), expand (the expand control), compact (a sidebar section's tight title). Used as a block, the block holds
the title's tools: wealth fields, spell slots, a sidebar block's buttons. --}}
<div class="flexrow -gap-sm l5r4-section-title{{#if compact}} -compact{{/if}}{{#if collapsed}} is-collapsed{{/if}}" data-section-title{{#if scope}} data-scope="{{scope}}"{{/if}}>
  <h4 class="l5r4-section-heading">{{localize label}}</h4>
  {{!-- The failover form renders nothing when the include has no block. Wrapping {{> @partial-block}} in
  {{#if @partial-block}} instead empties every block helper inside the caller's block --}}
  {{#> @partial-block}}{{/@partial-block}}
  {{#if create}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
  {{/if}}
  {{#if expand}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsed}}
  {{/if}}
</div>
