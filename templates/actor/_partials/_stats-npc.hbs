    <div class="l5r4-ring-rank -void" data-action="adjust-void-ring" data-ring="void" role="button" title="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
      <a class="l5r4-rank-control-arrow -up" data-action="increase-void-ring">
        <i class="fa-solid fa-chevron-up"></i>
      </a>
      <span>{{system.rings.void.rank}}</span>
      <a class="l5r4-rank-control-arrow -down" data-action="decrease-void-ring">
        <i class="fa-solid fa-chevron-down"></i>
      </a>
    </div>
    <div class="l5r4-ring -void">
      <a class="ring-roll draggable" data-action="roll-ring" data-ring-rank="{{system.rings.void.rank}}" data-ring-name="{{localize "l5r4.ui.mechanics.rings.void"}}" data-system-ring="void">
