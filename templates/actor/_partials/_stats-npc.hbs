<section class="flexcol -gap-sm l5r4-sheet-main">
  <div class="flexrow -gap-lg l5r4-pc-info">
    <div class="flexcol flex1">
      <div class="l5r4-form-field flexrow -gap-sm">
        <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.name"}}</h4>
        <div class="flexrow">
          <input class="flex1" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'l5r4.ui.common.name'}}" />
        </div>
      </div>
      {{#if summary.citation}}
        <p class="l5r4-citation">{{summary.citation}}</p>
      {{/if}}
    </div>
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_traits-rings.hbs" system=system traitsEff=@root.traitsEff showVoidPoints=@root.showNpcVoidPoints}}

  <section class="l5r4-section flexcol -gap-sm">
    {{#> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" label="l5r4.ui.sheets.attackAndDamage"}}
      {{#if firstEmptyAttack}}
        <button type="button" class="inline-control icon flex0" data-action="add-attack" data-attack-key="{{firstEmptyAttack}}" data-tooltip="{{localize "l5r4.ui.dialogs.addAttack"}}" aria-label="{{localize "l5r4.ui.dialogs.addAttack"}}"><i class="fa-solid fa-plus" inert></i></button>
      {{/if}}
    {{/"systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" type="attacks" columns=@root.sortColumns.npcAttacks}}
    <section class="l5r4-item-row-list -attacks">
      {{#each attacks}}
        {{#unless empty}}
          <div class="l5r4-item-row -attacks" data-attack-section="{{key}}">
            <h4 class="l5r4-item-row-name flexrow -gap-sm" data-attack-title>{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}</h4>
            {{> "systems/l5r4-enhanced/templates/cards/_partials/_roll-button.hbs" action="roll-attack" pool=attackPool tooltip=(localize "l5r4.ui.mechanics.combat.attack") data=(object attack-num=num roll=attack.roll keep=attack.keep modifier=attack.modifier description=actionLabel label=attackLabel)}}
            {{> "systems/l5r4-enhanced/templates/cards/_partials/_roll-button.hbs" action="roll-damage" pool=damagePool tooltip=(localize "l5r4.ui.mechanics.rolls.damageRoll") data=(object roll=damage.roll keep=damage.keep modifier=damage.modifier description=damage.type label=damageLabel)}}
            <div class="l5r4-item-row-cell">{{actionLabel}}</div>
            <div class="l5r4-item-row-cell">{{damage.type}}</div>
            {{> "systems/l5r4-enhanced/templates/cards/_partials/_controls.hbs" attackKey=key}}
          </div>
        {{/unless}}
      {{/each}}
    </section>
  </section>

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_skill-section.hbs"}}

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_note-section.hbs" system=system actor=actor enriched=enriched editable=editable}}
</section>
