        <p class="l5r4-void-points-label">{{localize "l5r4.ui.mechanics.rings.voidPoints"}}</p>
      </div>
    {{/if}}
  </div>

  <section class="flexcol -gap-sm">
    <div class="flexrow -gap-sm l5r4-section-title">
      <h4 class="l5r4-section-heading">{{localize "l5r4.ui.mechanics.combat.attack"}} & {{localize "l5r4.ui.common.damage"}}</h4>
      {{#if firstEmptyAttack}}
        <a class="button inline-control icon flex0" data-action="add-attack" data-attack-key="{{firstEmptyAttack}}" title="{{localize "l5r4.ui.dialogs.addAttack"}}"><i class="fa-solid fa-plus"></i></a>
      {{/if}}
    </div>
    <section class="l5r4-item-row-list -attacks l5r4-sort-header">
      <div class="l5r4-item-row">
        <span>{{localize "l5r4.ui.common.name"}}</span>
        <span>{{localize "l5r4.ui.mechanics.combat.attack"}}</span>
        <span>{{localize "l5r4.ui.common.damage"}}</span>
        <span>{{localize "l5r4.ui.common.action"}}</span>
        <span>{{localize "l5r4.ui.common.type"}}</span>
        <span></span>
      </div>
    </section>
    <section class="l5r4-item-row-list -attacks">
      {{#each attacks}}
        {{#unless empty}}
          <div class="l5r4-item-row -attacks -expandable" data-attack-section="{{key}}">
            <h4 class="flexrow -gap-sm title" data-attack-title>{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}</h4>
            <div class="l5r4-button -roll">
              <span class="l5r4-button-under">{{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}</span>
              <a class="button"
                 data-action="roll-attack"
                 data-attack-num="{{num}}"
                 data-roll="{{attack.roll}}"
                 data-keep="{{attack.keep}}"
                 data-modifier="{{attack.modifier}}"
                 data-description="{{attack.type}}"
                 data-label="{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}"
                 title="{{localize "l5r4.ui.mechanics.combat.attack"}}">
                {{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}
              </a>
            </div>
            <div class="l5r4-button -roll">
              <span class="l5r4-button-under">{{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}</span>
              <a class="button"
                 data-action="roll-damage"
                 data-roll="{{damage.roll}}"
                 data-keep="{{damage.keep}}"
                 data-modifier="{{damage.modifier}}"
                 data-description="{{damage.type}}"
                 data-label="{{localize "l5r4.ui.common.damage"}} {{num}}"
                 title="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">
                {{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}
              </a>
            </div>
            <div>
              {{attack.type}}
            </div>
            <div>
              {{attack.action}}
            </div>
            <div class="controls flexrow -gap-xs">
              <a class="button inline-control icon" data-action="edit-attack" data-attack-key="{{key}}" title="{{localize "l5r4.ui.common.edit"}}"><i class="fa-solid fa-pen-to-square"></i></a>
              <a class="button inline-control icon" data-action="delete-attack" data-attack-key="{{key}}" title="{{localize "l5r4.ui.common.delete"}}"><i class="fa-solid fa-trash"></i></a>
            </div>
          </div>
        {{/unless}}
      {{/each}}
    </section>
  </section>

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_skill-section.hbs"}}

  <section class="flexcol -gap-sm">
    <div class="flexrow -gap-sm l5r4-section-title">
      <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.notes"}}</h4>
    </div>
    <div class="l5r4-section-body">
      {{#if editable}}
        <prose-mirror
          name="system.notes"
          value="{{ system.notes }}"
          document-uuid="{{ actor.uuid }}"
          class="sized"
          compact>
          {{{ enriched.notes }}}
        </prose-mirror>
      {{else}}
        <div class="editor editor-content">
          {{{ enriched.notes }}}
        </div>
      {{/if}}
    </div>
  </section>
</section>
