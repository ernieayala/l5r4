  <section class="flexcol -gap-sm">
    <div class="flexrow -gap-sm section-title">
      <h4 class="title">{{localize "l5r4.ui.mechanics.combat.attack"}} & {{localize "l5r4.ui.common.damage"}}</h4>
      {{#if firstEmptyAttack}}
        <a class="button inline-control icon flex0" data-action="add-attack" data-attack-key="{{firstEmptyAttack}}" title="{{localize "l5r4.ui.dialogs.addAttack"}}"><i class="fas fa-plus"></i></a>
      {{/if}}
    </div>
    <section class="item-list -attacks -header">
      <div class="item">
        <span>{{localize "l5r4.ui.common.name"}}</span>
        <span>{{localize "l5r4.ui.mechanics.combat.attack"}}</span>
        <span>{{localize "l5r4.ui.common.damage"}}</span>
        <span>{{localize "l5r4.ui.common.action"}}</span>
        <span>{{localize "l5r4.ui.common.type"}}</span>
        <span></span>
      </div>
    </section>
    <section class="item-list -attacks">
      {{#each attacks}}
        {{#unless empty}}
          <div class="item -attacks -expandable" data-attack-section="{{key}}">
            <h4 class="flexrow -gap-sm title" data-attack-title>{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}</h4>
            <div class="button-mask-container">
              <span class="mas">{{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}</span>
              <a class="button"
                 data-action="roll-attack"
                 data-attack-num="{{num}}"
                 data-roll="{{attack.roll}}"
                 data-keep="{{attack.keep}}"
                 data-modifier="{{attack.modifier}}"
                 data-description="{{attack.type}}"
                 data-label="{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}"
                 title="{{localize "l5r4.ui.mechanics.combat.attack"}}">
                {{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}
              </a>
            </div>
            <div class="button-mask-container">
              <span class="mas">{{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}</span>
              <a class="button"
                 data-action="roll-damage"
                 data-roll="{{damage.roll}}"
                 data-keep="{{damage.keep}}"
                 data-modifier="{{damage.modifier}}"
                 data-description="{{damage.type}}"
                 data-label="{{localize "l5r4.ui.common.damage"}} {{num}}"
                 title="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">
                {{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}
              </a>
            </div>
            <div>
              {{attack.type}}
            </div>
            <div>
              {{attack.action}}
            </div>
            <div class="controls flexrow -gap-xs">
              <a class="button inline-control icon" data-action="edit-attack" data-attack-key="{{key}}" title="{{localize "l5r4.ui.common.edit"}}"><i class="fas fa-edit"></i></a>
              <a class="button inline-control icon" data-action="delete-attack" data-attack-key="{{key}}" title="{{localize "l5r4.ui.common.delete"}}"><i class="fas fa-trash"></i></a>
            </div>
          </div>
        {{/unless}}
      {{/each}}
    </section>
  </section>

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_skills-section.hbs"}}

  <section class="flexcol -gap-sm">
    <div class="flexrow -gap-sm section-title">
      <h4 class="title">{{localize "l5r4.ui.sheets.notes"}}</h4>
    </div>
    <div class="section-container">
      {{#if editable}}
        <prose-mirror
          name="system.notes"
          value="{{ system.notes }}"
          document-uuid="{{ actor.uuid }}"
          class="sized"
          compact>
          {{{ enriched.notes }}}
        </prose-mirror>
      {{else}}
        <div class="editor editor-content">
          {{{ enriched.notes }}}
        </div>
      {{/if}}
    </div>
  </section>
</section>
