  <section class="flexcol -gap-sm">
    <div class="flexrow -gap-sm section-title">
      <h4 class="title">{{localize "l5r4.ui.mechanics.combat.attack"}} & {{localize "l5r4.ui.common.damage"}}</h4>
    </div>
    <section class="item-list -attacks -header">
      <div class="item">
        <span>{{localize "l5r4.ui.common.name"}}</span>
        <span>{{localize "l5r4.ui.mechanics.combat.attack"}}</span>
        <span>{{localize "l5r4.ui.common.damage"}}</span>
        <span>{{localize "l5r4.ui.common.action"}}</span>
        <span>{{localize "l5r4.ui.common.type"}}</span>
        <span></span>
      </div>
    </section>
    <section class="item-list -attacks">
      <div class="item -attacks -expandable" data-attack-section="attack1">
        <h4 class="flexrow -gap-sm title" data-attack-title>{{#if system.attack1.name}}{{system.attack1.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} 1{{/if}}</h4>
        <div class="button-mask-container">
          <span class="mas">{{system.attack1.roll}}k{{system.attack1.keep}}{{#if system.attack1.modifier}}{{numberFormat system.attack1.modifier decimals=0 sign=true}}{{/if}}</span>
          <a class="button"
             data-action="roll-attack"
             data-roll="{{system.attack1.roll}}"
             data-keep="{{system.attack1.keep}}"
             data-modifier="{{system.attack1.modifier}}"
             data-description="{{system.attack1.type}}"
             data-label="{{#if system.attack1.name}}{{system.attack1.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} 1{{/if}}"
             title="{{localize "l5r4.ui.mechanics.combat.attack"}}">
            {{system.attack1.roll}}k{{system.attack1.keep}}{{#if system.attack1.modifier}}{{numberFormat system.attack1.modifier decimals=0 sign=true}}{{/if}}
          </a>
        </div>
        <div class="button-mask-container">
          <span class="mas">{{system.damage1.roll}}k{{system.damage1.keep}}{{#if system.damage1.modifier}}{{numberFormat system.damage1.modifier decimals=0 sign=true}}{{/if}}</span>
          <a class="button"
             data-action="roll-damage"
             data-roll="{{system.damage1.roll}}"
             data-keep="{{system.damage1.keep}}"
             data-modifier="{{system.damage1.modifier}}"
             data-description="{{system.damage1.type}}"
             data-label="{{localize "l5r4.ui.common.damage"}} 1"
             title="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">
            {{system.damage1.roll}}k{{system.damage1.keep}}{{#if system.damage1.modifier}}{{numberFormat system.damage1.modifier decimals=0 sign=true}}{{/if}}
          </a>
        </div>
        <div>
          {{system.attack1.type}}
        </div>
        <div>
          {{system.attack1.action}}
        </div>
        <div class="controls flexrow -gap-xs">
          <a class="button inline-control icon" data-action="edit-attack" data-attack-key="attack1" title="{{localize "l5r4.ui.common.edit"}}"><i class="fas fa-edit"></i></a>
        </div>
      </div>
