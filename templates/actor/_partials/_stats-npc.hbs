          </a>
        </span>
    </div>
    <div class="l5r4-trait -fire -intelligence">
      <div class="l5r4-button -roll draggable" data-action="roll-trait" data-trait-rank="{{system.traits.int}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.int"}}">
        <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.int"}}</span>
        <span title="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.int"}}</span>
      </div>
