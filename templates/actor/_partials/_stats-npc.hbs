<section class="flexcol -gap-sm l5r4-sheet-main">
  <div class="flexrow -gap-lg l5r4-pc-info">
    <div class="flexcol flex1">
      <div class="l5r4-form-field flexrow -gap-sm">
        <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.name"}}</h4>
        <div class="flexrow">
          <input class="flex1" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'l5r4.ui.common.name'}}" />
        </div>
      </div>
      {{#if summary.citation}}
        <p class="l5r4-citation">{{summary.citation}}</p>
      {{/if}}
    </div>
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_traits-rings.hbs" system=system traitsEff=@root.traitsEff showVoidPoints=@root.showNpcVoidPoints}}

  <section class="l5r4-section flexcol -gap-sm">
    <div class="flexrow -gap-sm l5r4-section-title" data-section-title>
      <h4 class="l5r4-section-heading">{{localize "l5r4.ui.mechanics.combat.attack"}} & {{localize "l5r4.ui.common.damage"}}</h4>
      {{#if firstEmptyAttack}}
        <button type="button" class="inline-control icon flex0" data-action="add-attack" data-attack-key="{{firstEmptyAttack}}" data-tooltip="{{localize "l5r4.ui.dialogs.addAttack"}}" aria-label="{{localize "l5r4.ui.dialogs.addAttack"}}"><i class="fa-solid fa-plus" inert></i></button>
      {{/if}}
    </div>
    <section class="l5r4-item-row-list -attacks l5r4-sort-header" data-sort-header>
      <div class="l5r4-item-row">
        <span>{{localize "l5r4.ui.common.name"}}</span>
        <span>{{localize "l5r4.ui.mechanics.combat.attack"}}</span>
        <span>{{localize "l5r4.ui.common.damage"}}</span>
        <span>{{localize "l5r4.ui.common.action"}}</span>
        <span>{{localize "l5r4.ui.common.type"}}</span>
        <span></span>
      </div>
    </section>
    <section class="l5r4-item-row-list -attacks">
      {{#each attacks}}
        {{#unless empty}}
          <div class="l5r4-item-row -attacks -expandable" data-attack-section="{{key}}">
            <h4 class="l5r4-item-row-name flexrow -gap-sm" data-attack-title>{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}</h4>
            <div class="l5r4-button -roll">
              <span class="l5r4-button-under">{{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}</span>
              <button type="button" class="l5r4-button-face"
                 data-action="roll-attack"
                 data-attack-num="{{num}}"
                 data-roll="{{attack.roll}}"
                 data-keep="{{attack.keep}}"
                 data-modifier="{{attack.modifier}}"
                 data-description="{{actionLabel}}"
                 data-label="{{#if attack.name}}{{attack.name}}{{else}}{{localize "l5r4.ui.mechanics.combat.attack"}} {{num}}{{/if}}"
                 data-tooltip="{{localize "l5r4.ui.mechanics.combat.attack"}}">
                {{attack.roll}}k{{attack.keep}}{{#if attack.modifier}}{{numberFormat attack.modifier decimals=0 sign=true}}{{/if}}
              </button>
            </div>
            <div class="l5r4-button -roll">
              <span class="l5r4-button-under">{{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}</span>
              <button type="button" class="l5r4-button-face"
                 data-action="roll-damage"
                 data-roll="{{damage.roll}}"
                 data-keep="{{damage.keep}}"
                 data-modifier="{{damage.modifier}}"
                 data-description="{{damage.type}}"
                 data-label="{{localize "l5r4.ui.common.damage"}} {{num}}"
                 data-tooltip="{{localize "l5r4.ui.mechanics.rolls.damageRoll"}}">
                {{damage.roll}}k{{damage.keep}}{{#if damage.modifier}}{{numberFormat damage.modifier decimals=0 sign=true}}{{/if}}
              </button>
            </div>
            <div>
              {{actionLabel}}
            </div>
            <div>
              {{attack.action}}
            </div>
            <div class="l5r4-inline-control -reveal flexrow -gap-xs">
              <button type="button" class="inline-control icon" data-action="edit-attack" data-attack-key="{{key}}" data-tooltip="{{localize "l5r4.ui.common.edit"}}" aria-label="{{localize "l5r4.ui.common.edit"}}"><i class="fa-solid fa-pen-to-square" inert></i></button>
              <button type="button" class="inline-control icon" data-action="delete-attack" data-attack-key="{{key}}" data-tooltip="{{localize "l5r4.ui.common.delete"}}" aria-label="{{localize "l5r4.ui.common.delete"}}"><i class="fa-solid fa-trash" inert></i></button>
            </div>
          </div>
        {{/unless}}
      {{/each}}
    </section>
  </section>

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_skill-section.hbs"}}

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_note-section.hbs" system=system actor=actor enriched=enriched editable=editable}}
</section>
