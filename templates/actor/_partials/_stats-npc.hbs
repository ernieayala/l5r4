      </div>
      <span class="l5r4-rank-control -trait" data-action="adjust-trait" data-trait="awa" role="button" title="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
          <a class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="awa">
            <i class="fa-solid fa-chevron-up"></i>
          </a>
          <span>{{@root.traitsEff.awa}}</span>
          <a class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="awa">
            <i class="fa-solid fa-chevron-down"></i>
          </a>
        </span>
    </div>

    <!-- Water ring -->
    <h4 class="l5r4-ring-name -water">{{localize "l5r4.ui.mechanics.rings.water"}}</h4>
    <h4 class="l5r4-ring-rank -water"><span>{{system.rings.water}}</span></h4>
    <div class="l5r4-ring -water">
      <a class="ring-roll draggable" data-action="roll-ring" data-ring-rank="{{system.rings.water}}" data-ring-name="{{localize "l5r4.ui.mechanics.rings.water"}}" data-system-ring="water">
        <img src="{{iconPath 'water.webp'}}" title="{{localize "l5r4.ui.mechanics.rolls.ringRoll"}}" class="l5r4-ring-image" />
