<section class="flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.tattoos}} is-collapsed{{/if}}" data-scope="tattoos">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.tattoos"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs"}}
  </div>
  <section class="l5r4-item-row-list -tattoo l5r4-sort-header" data-scope="tattoos">
    <div class="l5r4-item-row">
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</a>
    </div>
  </section>
  <section class="l5r4-item-row-list -tattoo">
    {{#each tattoos as |tattoo id|}}
      {{> "systems/l5r4-enhanced/templates/cards/tattoo.hbs" system=tattoo.system inSheet=true docId=tattoo.id active=(includes @root.activeItemIds tattoo.id)}}
    {{/each}}
  </section>
</section>
