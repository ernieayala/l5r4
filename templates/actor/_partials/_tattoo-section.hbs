<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.tattoos}} is-collapsed{{/if}}" data-section-title data-scope="tattoos">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.tattoos"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.tattoos}}
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="tattoos" type="tattoo" columns=@root.sortColumns.tattoos sort=@root.sortState.tattoos}}
  <section class="l5r4-item-row-list -tattoo">
    {{#each tattoos as |tattoo id|}}
      {{> "systems/l5r4-enhanced/templates/cards/tattoo.hbs" system=tattoo.system inSheet=true docId=tattoo.id active=(includes @root.activeItemIds tattoo.id)}}
    {{/each}}
  </section>
</section>
