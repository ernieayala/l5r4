<section class="l5r4-section l5r4-fear">
  <div class="flexrow -gap-sm l5r4-section-title -compact" data-section-title>
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.mechanics.fear.title"}}</h4>
  </div>
  <div class="flexcol -gap-sm l5r4-fear-body">
    <div class="l5r4-grid">
      <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.fear.rank"}}</span>
      <div class="flexrow l5r4-grid-value">
        <input
          name="system.fear.rank"
          type="number"
          value="{{system.fear.rank}}"
          min="0"
          max="10"
          data-type="Number"
          aria-label="{{localize "l5r4.ui.mechanics.fear.rank"}}"
        />
      </div>
    </div>
    {{#if system.fear.rank}}
      <button
        type="button"
        class="button l5r4-fear-test"
        data-action="test-fear"
        data-fear-rank="{{system.fear.rank}}"
        data-tooltip="{{localize "l5r4.ui.mechanics.fear.rollForSelected"}}"
      >
        {{localize "l5r4.ui.mechanics.fear.label" rank=system.fear.rank}}
      </button>
    {{/if}}
  </div>
</section>
