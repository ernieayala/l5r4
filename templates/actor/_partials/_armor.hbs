{{!-- Armor TN and Reduction (armor-tn-block.md): computed text on a PC, typed in on an NPC --}}
<section class="l5r4-section l5r4-armor">
  {{#> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" label="l5r4.ui.common.armor" compact=true}}
    {{#if (eq actor.type "pc")}}
      <button
        type="button"
        class="button inline-control icon"
        data-action="open-armor-config"
        data-tooltip="{{localize "l5r4.ui.common.armor"}}"
        aria-label="{{localize "l5r4.ui.common.armor"}}"
      >
        <i class="fa-solid fa-gear" inert></i>
      </button>
    {{/if}}
  {{/"systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs"}}
  <div class="l5r4-grid">
    <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.wounds.armorTn"}}</span>
    {{#if (eq actor.type "pc")}}
      <div class="flexrow l5r4-grid-value">
        <span>{{system.armorTn.current}}</span>
        {{#if (gt system.rings.void.rank 0)}}
          <input
            class="flex0"
            type="checkbox"
            {{checked voidArmor}}
            data-action="toggle-armor-void"
            data-tooltip="{{localize "l5r4.ui.mechanics.rings.voidTnBoost"}}"
            aria-label="{{localize "l5r4.ui.mechanics.rings.voidTnBoost"}}"
          />
        {{/if}}
      </div>
    {{else}}
      <div class="flexrow l5r4-grid-value"><input
          type="number"
          name="system.armor.armorTn"
          value="{{system.armor.armorTn}}"
          data-type="Number"
          aria-label="{{localize "l5r4.ui.mechanics.wounds.armorTn"}}"
        /></div>
    {{/if}}
    {{#unless (eq actor.type "pc")}}
      {{!-- The part of the NPC's Armor TN that is armor worn, which Grappled and Stunned keep (#152) --}}
      <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.wounds.armorWorn"}}</span>
      <div class="flexrow l5r4-grid-value"><input
          type="number"
          name="system.armor.bonus"
          value="{{system.armor.bonus}}"
          min="0"
          data-type="Number"
          aria-label="{{localize "l5r4.ui.mechanics.wounds.armorWorn"}}"
          data-tooltip="{{localize "l5r4.ui.mechanics.wounds.armorWornHint"}}"
        /></div>
    {{/unless}}
    <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.wounds.armorReduction"}}</span>
    {{#if (eq actor.type "pc")}}
      <div class="flexrow l5r4-grid-value"><span>{{system.armorTn.reduction}}</span></div>
    {{else}}
      <div class="flexrow l5r4-grid-value"><input
          type="number"
          name="system.armor.reduction"
          value="{{system.armor.reduction}}"
          data-type="Number"
          aria-label="{{localize "l5r4.ui.mechanics.wounds.armorReduction"}}"
        /></div>
    {{/if}}
  </div>
</section>
