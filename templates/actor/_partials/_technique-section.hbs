<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.techniques}} is-collapsed{{/if}}" data-section-title data-scope="techniques">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.techniques"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.techniques}}
  </div>
  <section class="l5r4-item-row-list -technique l5r4-sort-header" data-sort-header data-scope="techniques">
    <div class="l5r4-item-row">
      <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</button>
    </div>
  </section>
  <section class="l5r4-item-row-list -technique">
    {{#each techniques as |technique id|}}
      {{> "systems/l5r4-enhanced/templates/cards/technique.hbs" system=technique.system inSheet=true docId=technique.id}}
    {{/each}}
  </section>
</section>
