<section class="l5r4-section flexcol -gap-sm">
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" scope="techniques" label="l5r4.ui.sheets.techniques" collapsed=collapsedSections.techniques create=true expand=true}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="techniques" type="technique" columns=@root.sortColumns.techniques sort=@root.sortState.techniques}}
  <section class="l5r4-item-row-list -technique">
    {{#each techniques as |technique id|}}
      {{> "systems/l5r4-enhanced/templates/cards/technique.hbs" system=technique.system inSheet=true docId=technique.id}}
    {{/each}}
  </section>
</section>
