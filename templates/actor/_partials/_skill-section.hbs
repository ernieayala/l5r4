<section class="flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.skills}} is-collapsed{{/if}}" data-scope="skills">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.skills"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs"}}
  </div>
  <section class="l5r4-item-row-list -skill l5r4-sort-header" data-scope="skills">
    <div class="l5r4-item-row">
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="rank">{{localize "l5r4.ui.common.rank"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="trait">{{localize "l5r4.character.skills.properties.trait"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="roll">{{localize "l5r4.ui.common.roll"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="emphasis">{{localize "l5r4.character.skills.properties.emphasis"}}</a>
      <span></span>
    </div>
  </section>
  <section class="l5r4-item-row-list -skill">
    {{#each skills as |skill id|}}
      {{> "systems/l5r4-enhanced/templates/cards/skill.hbs"
          name=skill.name
          type=skill.type
          system=skill.system
          inSheet=true
          docId=skill.id}}
    {{/each}}
  </section>
</section>
