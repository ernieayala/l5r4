<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.skills}} is-collapsed{{/if}}" data-section-title data-scope="skills">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.skills"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.skills}}
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="skills" type="skill" columns=@root.sortColumns.skills sort=@root.sortState.skills}}
  <section class="l5r4-item-row-list -skill">
    {{#each skills as |skill id|}}
      {{> "systems/l5r4-enhanced/templates/cards/skill.hbs"
          name=skill.name
          type=skill.type
          system=skill.system
          inSheet=true
          docId=skill.id}}
    {{/each}}
  </section>
</section>
