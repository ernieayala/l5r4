<section class="flexcol -gap-sm l5r4-sheet-main">
  <div class="flexcol l5r4-actor-header -gap-lg">
    <div class="flexrow -gap-lg l5r4-pc-info">
      <div class="flexcol flex1">
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label"><button type="button" class="l5r4-form-field-label-button" data-action="recalculate-sheet">{{localize "l5r4.ui.common.name"}}</button></h4>
          <div class="flexrow">
            <input class="flex1" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'l5r4.ui.common.name'}}" />
          </div>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.clan"}}</h4>
          <div class="flex1 l5r4-form-field-value">{{system.clan}}</div>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.school"}}</h4>
          <div class="flex1 l5r4-form-field-value">{{system.school}}</div>
        </div>
      </div>
      <div class="flexcol flex1">
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label"><button type="button" class="l5r4-form-field-label-button" data-action="toggle-rank-mode" {{#if @root.isGM}}data-tooltip="{{localize "l5r4.ui.hints.shiftClickToggleRankMode"}}"{{/if}}>{{localize "l5r4.ui.common.insight"}} {{localize "l5r4.ui.common.rank"}}</button></h4>
          {{#if system.insight.autoCalculate}}
            <div class="flex1 l5r4-form-field-value">{{system.insight.rank}}</div>
          {{else}}
            <input class="flex1" type="number" name="system.insight.rank" value="{{system.insight.rank}}" />
          {{/if}}
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.xp"}}</h4>
          <div class="flexrow flex1 -gap-xs l5r4-form-field-value">
            {{#if system._xp}}
              <div class="l5r4-form-field-group flexrow -gap-md">
                <span class="flex0">{{system._xp.spent}}/{{system._xp.total}}</span>
                <button type="button" class="inline-control icon" data-action="open-xp-manager" data-tooltip="{{localize "l5r4.apps.xpManager.open"}}" aria-label="{{localize "l5r4.apps.xpManager.open"}}"><i class="fa-solid fa-chart-line" inert></i></button>
              </div>
            {{/if}}
          </div>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <h4 class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.insight"}}</h4>
          <div class="flex1 l5r4-form-field-value">{{system.insight.points}}</div>
        </div>
      </div>
    </div>
    <div class="traits-rings">
      {{!-- Earth ring --}}
      <h4 class="l5r4-ring-name -earth">{{localize "l5r4.ui.mechanics.rings.earth"}}</h4>
      <h4 class="l5r4-ring-rank -earth"><span>{{system.rings.earth}}</span></h4>
      <div class="l5r4-ring -earth">
        <button type="button" class="ring-roll draggable" data-action="roll-ring" data-ring-rank="{{system.rings.earth}}" data-ring-name="{{localize "l5r4.ui.mechanics.rings.earth"}}" data-system-ring="earth" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.ringRoll"}}" aria-label="{{localize "l5r4.ui.mechanics.rolls.ringRoll"}}">
          <img src="{{iconPath 'earth.webp'}}" alt="" class="l5r4-ring-image" />
        </button>
      </div>
      <div class="l5r4-trait -earth -stamina">
        <div class="l5r4-button -roll draggable">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.sta"}}</span>
          <button type="button" class="l5r4-button-face" data-action="roll-trait" data-trait-rank="{{system.traits.sta}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.sta"}}" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.sta"}}</button>
        </div>
        <span class="l5r4-rank-control -trait" data-action="adjust-trait" data-trait="sta" role="button" data-tooltip="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
          <button type="button" class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="sta" data-tooltip="{{localize "l5r4.ui.common.increase"}}" aria-label="{{localize "l5r4.ui.common.increase"}}">
            <i class="fa-solid fa-chevron-up" inert></i>
          </button>
          <span>{{@root.traitsEff.sta}}</span>
          <button type="button" class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="sta" data-tooltip="{{localize "l5r4.ui.common.decrease"}}" aria-label="{{localize "l5r4.ui.common.decrease"}}">
            <i class="fa-solid fa-chevron-down" inert></i>
          </button>
        </span>
      </div>
      <div class="l5r4-trait -earth -willpower">
        <div class="l5r4-button -roll draggable">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.wil"}}</span>
          <button type="button" class="l5r4-button-face" data-action="roll-trait" data-trait-rank="{{system.traits.wil}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.wil"}}" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.wil"}}</button>
        </div>
        <span class="l5r4-rank-control -trait" data-action="adjust-trait" data-trait="wil" role="button" data-tooltip="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
          <button type="button" class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="wil" data-tooltip="{{localize "l5r4.ui.common.increase"}}" aria-label="{{localize "l5r4.ui.common.increase"}}">
            <i class="fa-solid fa-chevron-up" inert></i>
          </button>
          <span>{{@root.traitsEff.wil}}</span>
          <button type="button" class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="wil" data-tooltip="{{localize "l5r4.ui.common.decrease"}}" aria-label="{{localize "l5r4.ui.common.decrease"}}">
            <i class="fa-solid fa-chevron-down" inert></i>
          </button>
        </span>
      </div>

      {{!-- Air ring --}}
