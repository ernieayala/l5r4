<section class="flexcol -gap-sm l5r4-sheet-main">
  <div class="flexcol l5r4-actor-header -gap-lg">
    <div class="flexrow -gap-lg l5r4-pc-info">
      <div class="flexcol flex1">
        {{!-- A <div>, not a <label>: a label around the recalculate button would add its name to the input's --}}
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.name"}}</span>
          <div class="flexrow">
            <input
              class="flex1"
              type="text"
              name="name"
              value="{{actor.name}}"
              placeholder="{{localize "l5r4.ui.common.name"}}"
              aria-label="{{localize "l5r4.ui.common.name"}}"
            />
          </div>
          <button
            type="button"
            class="flex0 inline-control icon"
            data-action="recalculate-sheet"
            data-tooltip="{{localize "l5r4.ui.sheets.recalculateSheet"}}"
            aria-label="{{localize "l5r4.ui.sheets.recalculateSheet"}}"
          >
            <i class="fa-solid fa-arrows-rotate" inert></i>
          </button>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.clan"}}</span>
          <div class="flex1 l5r4-form-field-value">{{system.clan}}</div>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.school"}}</span>
          <div class="flex1 l5r4-form-field-value">{{system.school}}</div>
        </div>
      </div>
      <div class="flexcol flex1">
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.insightRank"}}</span>
          {{#if system.insight.autoCalculate}}
            <div class="flex1 l5r4-form-field-value">{{system.insight.rank}}</div>
          {{else}}
            <input
              class="flex1"
              type="number"
              name="system.insight.rank"
              value="{{system.insight.rank}}"
              aria-label="{{localize "l5r4.ui.common.insightRank"}}"
            />
          {{/if}}
          {{#if @root.isGM}}
            <button
              type="button"
              class="flex0 inline-control icon"
              data-action="toggle-rank-mode"
              aria-pressed="{{#if system.insight.autoCalculate}}false{{else}}true{{/if}}"
              data-tooltip="{{localize "l5r4.ui.sheets.typeInsightRank"}}"
              aria-label="{{localize "l5r4.ui.sheets.typeInsightRank"}}"
            >
              <i class="fa-solid {{#if system.insight.autoCalculate}}fa-lock{{else}}fa-lock-open{{/if}}" inert></i>
            </button>
          {{/if}}
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.xp"}}</span>
          <div class="flexrow flex1 -gap-xs l5r4-form-field-value">
            {{#if system._xp}}
              <div class="l5r4-form-field-group flexrow -gap-md">
                <span class="flex0">{{system._xp.spent}}/{{system._xp.total}}</span>
                {{#if system._xp.overspent}}
                  {{!-- Spent past the total is the player's and GM's call: marked, never refused (#145) --}}
                  <span
                    class="flex0 l5r4-form-field-warning"
                    role="note"
                    data-xp-overspent
                    data-tooltip="{{localize "l5r4.character.experience.overspent" over=system._xp.overspent}}"
                    aria-label="{{localize "l5r4.character.experience.overspent" over=system._xp.overspent}}"
                  ><i class="fa-solid fa-triangle-exclamation" inert></i></span>
                {{/if}}
                <button type="button" class="inline-control icon" data-action="open-xp-manager" data-tooltip="{{localize "l5r4.apps.xpManager.open"}}" aria-label="{{localize "l5r4.apps.xpManager.open"}}"><i class="fa-solid fa-chart-line" inert></i></button>
              </div>
            {{/if}}
          </div>
        </div>
        <div class="l5r4-form-field flexrow -gap-sm">
          <span class="flex0 l5r4-form-field-label">{{localize "l5r4.ui.common.insight"}}</span>
          <div class="flex1 l5r4-form-field-value">{{system.insight.points}}</div>
        </div>
      </div>
    </div>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_traits-rings.hbs" system=system traitsEff=@root.traitsEff showVoidPoints=true}}
  </div>

  {{#if skills.length}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_skill-section.hbs"}}
  {{/if}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_item-sections.hbs" wealth=true}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_bio.hbs"}}

  {{> "systems/l5r4-enhanced/templates/actor/_partials/_note-section.hbs" system=system actor=actor enriched=enriched editable=editable}}
</section>
