      </div>
      <div class="l5r4-trait -water -strength">
        <div class="l5r4-button -roll draggable" data-action="roll-trait" data-trait-rank="{{system.traits.str}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.str"}}">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.str"}}</span>
          <span title="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.str"}}</span>
        </div>
        <span class="l5r4-rank-control -trait" data-action="adjust-trait" data-trait="str" role="button" title="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
          <a class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="str">
            <i class="fa-solid fa-chevron-up"></i>
          </a>
          <span>{{@root.traitsEff.str}}</span>
          <a class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="str">
            <i class="fa-solid fa-chevron-down"></i>
