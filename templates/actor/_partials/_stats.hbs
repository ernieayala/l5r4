          <button type="button" class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="str" data-tooltip="{{localize "l5r4.ui.common.increase"}}" aria-label="{{localize "l5r4.ui.common.increase"}}">
            <i class="fa-solid fa-chevron-up" inert></i>
          </button>
          <span>{{@root.traitsEff.str}}</span>
