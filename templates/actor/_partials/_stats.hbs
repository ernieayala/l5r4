        <div class="l5r4-button -roll draggable">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.per"}}</span>
          <button type="button" class="l5r4-button-face" data-action="roll-trait" data-trait-rank="{{system.traits.per}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.per"}}" data-tooltip="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.per"}}</button>
        </div>
