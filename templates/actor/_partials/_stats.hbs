          </a>
          <span>{{@root.traitsEff.per}}</span>
          <a class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="per">
            <i class="fa-solid fa-chevron-down"></i>
          </a>
        </span>
      </div>

      <!-- Fire ring -->
      <h4 class="l5r4-ring-name -fire">{{localize "l5r4.ui.mechanics.rings.fire"}}</h4>
      <h4 class="l5r4-ring-rank -fire"><span>{{system.rings.fire}}</span></h4>
      <div class="l5r4-ring -fire">
        <a class="ring-roll draggable" data-action="roll-ring" data-ring-rank="{{system.rings.fire}}" data-ring-name="{{localize "l5r4.ui.mechanics.rings.fire"}}" data-system-ring="fire">
          <img src="{{iconPath 'fire.webp'}}" title="{{localize "l5r4.ui.mechanics.rolls.ringRoll"}}" class="l5r4-ring-image" />
        </a>
      </div>
      <div class="l5r4-trait -fire -agility">
        <div class="l5r4-button -roll draggable" data-action="roll-trait" data-trait-rank="{{system.traits.agi}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.agi"}}">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.agi"}}</span>
          <span title="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.agi"}}</span>
        </div>
        <span class="l5r4-rank-control -trait" data-action="adjust-trait" data-trait="agi" role="button" title="{{localize "l5r4.ui.hints.leftClickPlusRightClickMinus"}}">
          <a class="l5r4-rank-control-arrow -up" data-action="increase-trait" data-trait="agi">
            <i class="fa-solid fa-chevron-up"></i>
          </a>
          <span>{{@root.traitsEff.agi}}</span>
          <a class="l5r4-rank-control-arrow -down" data-action="decrease-trait" data-trait="agi">
