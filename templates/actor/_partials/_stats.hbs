  {{/if}}
  {{#if advantages.length}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_advantage-section.hbs"}}
  {{/if}}
  {{#if disadvantages.length}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_disadvantage-section.hbs"}}
  {{/if}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_bio.hbs"}}

  <section class="l5r4-section flexcol -gap-sm">
    <div class="flexrow -gap-sm l5r4-section-title">
      <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.notes"}}</h4>
    </div>
    <div class="l5r4-section-body">
      {{#if editable}}
        <prose-mirror
          name="system.notes"
          value="{{ system.notes }}"
          document-uuid="{{ actor.uuid }}"
          compact>
          {{{ enriched.notes }}}
        </prose-mirror>
      {{else}}
        <div class="editor editor-content">
          {{{ enriched.notes }}}
        </div>
      {{/if}}
    </div>
  </section>
</section>
