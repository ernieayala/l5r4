        <a class="l5r4-rank-control-arrow -up" data-action="increase-void-ring">
          <i class="fa-solid fa-chevron-up"></i>
        </a>
        <span>{{system.rings.void.rank}}</span>
        <a class="l5r4-rank-control-arrow -down" data-action="decrease-void-ring">
          <i class="fa-solid fa-chevron-down"></i>
        </a>
      </div>
      <div class="l5r4-ring -void">
