      <div class="l5r4-trait -air -reflexes">
        <div class="l5r4-button -roll draggable" data-action="roll-trait" data-trait-rank="{{system.traits.ref}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.ref"}}">
          <span class="l5r4-button-under">{{localize "l5r4.ui.mechanics.traits.ref"}}</span>
          <span title="{{localize "l5r4.ui.mechanics.rolls.traitRoll"}}">{{localize "l5r4.ui.mechanics.traits.ref"}}</span>
