      <div class="l5r4-trait -water -perception">
        <div class="l5r4-button -roll draggable" data-action="roll-trait" data-trait-rank="{{system.traits.per}}" data-trait-name="{{localize "l5r4.ui.mechanics.traits.per"}}">
