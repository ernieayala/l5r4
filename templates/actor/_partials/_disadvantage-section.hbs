<section class="l5r4-section flexcol -gap-sm">
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" scope="disadvantages" label="l5r4.ui.sheets.disadvantages" collapsed=collapsedSections.disadvantages create=true expand=true}}
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="disadvantages" type="disadvantage" columns=@root.sortColumns.disadvantages sort=@root.sortState.disadvantages}}
  <section class="l5r4-item-row-list -disadvantage">
    {{#each disadvantages as |item id|}}
      {{> "systems/l5r4-enhanced/templates/cards/advantage-disadvantage.hbs"
          system=item.system
          inSheet=true
          docId=item.id}}
    {{/each}}
  </section>
</section>
