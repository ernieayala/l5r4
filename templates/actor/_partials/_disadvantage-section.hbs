<section class="flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.disadvantages}} is-collapsed{{/if}}" data-scope="disadvantages">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.disadvantages"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs"}}
  </div>
  <section class="l5r4-item-row-list -disadvantage l5r4-sort-header" data-scope="disadvantages">
    <div class="l5r4-item-row">
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="type">{{localize "l5r4.ui.common.type"}}</a>
      <a class="l5r4-sort-header-button" data-action="sort-items" data-sortby="cost">{{localize "l5r4.ui.common.cost"}}</a>
    </div>
  </section>
  <section class="l5r4-item-row-list -disadvantage">
    {{#each disadvantages as |item id|}}
      {{> "systems/l5r4-enhanced/templates/cards/advantage-disadvantage.hbs"
          system=item.system
          inSheet=true
          docId=item.id}}
    {{/each}}
  </section>
</section>
