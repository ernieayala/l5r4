<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.disadvantages}} is-collapsed{{/if}}" data-section-title data-scope="disadvantages">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.disadvantages"}}</h4>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.disadvantages}}
  </div>
  {{> "systems/l5r4-enhanced/templates/actor/_partials/_sort-header.hbs" scope="disadvantages" type="disadvantage" columns=@root.sortColumns.disadvantages}}
  <section class="l5r4-item-row-list -disadvantage">
    {{#each disadvantages as |item id|}}
      {{> "systems/l5r4-enhanced/templates/cards/advantage-disadvantage.hbs"
          system=item.system
          inSheet=true
          docId=item.id}}
    {{/each}}
  </section>
</section>
