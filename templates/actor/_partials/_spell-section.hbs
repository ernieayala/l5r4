<section class="l5r4-section flexcol -gap-sm">
  <div class="flexrow -gap-sm l5r4-section-title{{#if collapsedSections.spells}} is-collapsed{{/if}}" data-section-title data-scope="spells">
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.sheets.spells"}}</h4>
    <div class="flexrow -gap-sm l5r4-spell-slots">
        <span>{{localize "l5r4.ui.sheets.spellSlots"}}:</span>
        {{> "systems/l5r4-enhanced/templates/actor/_partials/_spell-slot.hbs" ring="water" count=system.spellSlots.water}}
        {{> "systems/l5r4-enhanced/templates/actor/_partials/_spell-slot.hbs" ring="air" count=system.spellSlots.air}}
        {{> "systems/l5r4-enhanced/templates/actor/_partials/_spell-slot.hbs" ring="fire" count=system.spellSlots.fire}}
        {{> "systems/l5r4-enhanced/templates/actor/_partials/_spell-slot.hbs" ring="earth" count=system.spellSlots.earth}}
        {{> "systems/l5r4-enhanced/templates/actor/_partials/_spell-slot.hbs" ring="void" count=system.spellSlots.void}}
    </div>
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_unified-item-create.hbs"}}
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_expand.hbs" collapsed=collapsedSections.spells}}
  </div>
  <section class="l5r4-item-row-list -spell l5r4-sort-header" data-sort-header data-scope="spells">
    <div class="l5r4-item-row">
      <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="name">{{localize "l5r4.ui.common.name"}}</button>
      <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="ring">{{localize "l5r4.ui.common.ring"}}</button>
      <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="mastery">{{localize "l5r4.ui.common.mastery"}}</button>
      <span>{{localize "l5r4.magic.spells.cast"}}</span>
      <span></span>
    </div>
  </section>
  <section class="l5r4-item-row-list -spell">
    {{#each spells as |spell id|}}
      {{> "systems/l5r4-enhanced/templates/cards/spell.hbs" system=spell.system inSheet=true docId=spell.id}}
    {{/each}}
  </section>
</section>
