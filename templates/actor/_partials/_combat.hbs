<section class="l5r4-section l5r4-combat">
  {{#> "systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs" label="l5r4.character.stance.title" compact=true}}
    <button
      type="button"
      class="button inline-control icon"
      data-action="open-condition-manager"
      data-tooltip="{{localize "l5r4.ui.common.conditions"}}"
      aria-label="{{localize "l5r4.ui.common.conditions"}}"
    >
      <i class="fa-solid fa-heart-pulse" inert></i>
    </button>
    <button
      type="button"
      class="button inline-control icon"
      data-action="open-combat-config"
      data-tooltip="{{localize "l5r4.apps.combatConfig.title"}}"
      aria-label="{{localize "l5r4.apps.combatConfig.title"}}"
    >
      <i class="fa-solid fa-gear" inert></i>
    </button>
  {{/"systems/l5r4-enhanced/templates/actor/_partials/_section-title.hbs"}}
  <div class="l5r4-grid">
    <span class="l5r4-grid-label">{{localize "l5r4.character.stance.current"}}</span>
    <div class="flexrow l5r4-grid-value">
      <select data-action="apply-stance" aria-label="{{localize "l5r4.character.stance.current"}}">
        {{#each config.stances as |label id|}}
          <option value="{{id}}" {{#if (eq ../currentStance id)}}selected{{/if}}>
            {{localize label}}
          </option>
        {{/each}}
      </select>
    </div>
    <span class="l5r4-grid-label">{{localize "l5r4.ui.common.initiative"}}</span>
    <div class="flexrow -gap-sm l5r4-grid-value">
      <span class="l5r4-combat-initiative">{{initiativeFormula}}</span>
      {{#if (gt system.rings.void.rank 0)}}
        <input
            class="flex0"
            type="checkbox"
            name="system.initiative.useVoid"
            {{checked system.initiative.useVoid}}
            data-action="toggle-initiative-void"
            data-tooltip="{{localize "l5r4.ui.mechanics.rings.voidInitBoost"}}"
            aria-label="{{localize "l5r4.ui.mechanics.rings.voidInitBoost"}}"
          />
      {{/if}}
    </div>
    <span class="l5r4-grid-label">{{localize "l5r4.character.movement.title"}}</span>
    <div class="flexrow -gap-sm l5r4-grid-value">
      <div>
        {{#if system.movement.showSimple}}
          {{system.movement.simpleAction}}{{localize "l5r4.character.movement.feet"}}
        {{else}}
          {{system.movement.freeAction}}{{localize "l5r4.character.movement.feet"}}
        {{/if}}
      </div>
      {{#if system.movement.showSimple}}
        <button type="button" data-action="toggle-movement-type" 
          data-tooltip="{{localize "l5r4.ui.common.simple"}}">
          {{localize "l5r4.ui.common.simple"}}
        </button>
      {{else}}
        <button type="button" data-action="toggle-movement-type" 
          data-tooltip="{{localize "l5r4.ui.common.free"}}">
          {{localize "l5r4.ui.common.free"}}
        </button>
      {{/if}}
    </div>
    <span class="l5r4-grid-label">{{localize "l5r4.character.movement.maximum"}}</span>
    <div class="flexrow -gap-sm l5r4-grid-value">{{system.movement.maximum}}{{localize "l5r4.character.movement.feet"}}</div>
  </div>
</section>
