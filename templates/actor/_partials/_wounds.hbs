<section class="l5r4-section">
  <div class="flexrow -gap-sm l5r4-section-title" data-section-title>
    <h4 class="l5r4-section-heading -compact">{{localize "l5r4.ui.mechanics.wounds.label"}}</h4>
    <button
      type="button"
      class="button inline-control icon"
      data-action="apply-healing"
      data-tooltip="{{localize "l5r4.ui.mechanics.wounds.applyHealingTitle"}}"
      aria-label="{{localize "l5r4.ui.mechanics.wounds.applyHealingTitle"}}"
    >
      <i class="fa-solid fa-bed" inert></i>
    </button>
    <button
      type="button"
      class="button inline-control icon"
      data-action="open-wound-config"
      data-tooltip="{{localize "l5r4.apps.woundConfig.title"}}"
      aria-label="{{localize "l5r4.apps.woundConfig.title"}}"
    >
      <i class="fa-solid fa-gear" inert></i>
    </button>
  </div>
  <div class="l5r4-grid">
    <span>{{localize "l5r4.ui.mechanics.wounds.suffered"}}</span>
    <div class="flexrow"><input
        type="number"
        name="system.suffered"
        value="{{system.suffered}}"
        data-type="Number"
      /></div>

    {{#if (eq actor.type "pc")}}
      <span data-tooltip="{{localize "l5r4.ui.mechanics.wounds.healRateBreakdown" sta=system.traits.sta rank=system.insight.rank mod=system.wounds.mod}}">{{localize "l5r4.ui.mechanics.wounds.woundHealRate"}}</span>
      <div class="flexrow">{{system.wounds.healRate}}</div>
    {{/if}}

    {{#if (and (eq actor.type "npc") (eq system.woundMode "manual"))}}
      <span>{{localize "l5r4.ui.mechanics.wounds.maxWounds"}}</span>
      <div class="flexrow"><input
          type="number"
          value="{{system.wounds.max}}"
          data-type="Number"
          disabled
        /></div>
    {{/if}}

    <div class="l5r4-wound-track">
      <span>{{localize "l5r4.ui.mechanics.wounds.woundLevel"}}</span>
      <span>{{localize "l5r4.ui.mechanics.wounds.penalty"}}</span>
      <span>{{localize "l5r4.ui.mechanics.wounds.threshold"}}</span>
      <span>{{localize "l5r4.ui.common.current"}}</span>
      {{#if (eq actor.type "npc")}}
        {{#each system.visibleWoundLevels as |lvl name|}}
          <div>{{localize (concat "l5r4.ui.mechanics.wounds." name)}}</div>
          <div>{{penaltyEff}}</div>
          <div>{{value}}</div>
          <div>
            {{#if current}}
              <input type="checkbox" disabled {{checked current}} data-type="Boolean" />
            {{/if}}
          </div>
        {{/each}}
      {{else}}
        {{#each system.woundLevels as |lvl name|}}
          <div>{{localize (concat "l5r4.ui.mechanics.wounds." name)}}</div>
          <div>{{penaltyEff}}</div>
          <div>{{value}}</div>
          <div>
            {{#if current}}
              <input type="checkbox" disabled {{checked current}} data-type="Boolean" />
            {{/if}}
          </div>
        {{/each}}
      {{/if}}
    </div>
  </div>

</section>