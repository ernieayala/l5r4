<section class="l5r4-section">
  <div class="flexrow -gap-sm l5r4-section-title -compact" data-section-title>
    <h4 class="l5r4-section-heading">{{localize "l5r4.ui.mechanics.wounds.label"}}</h4>
    <button
      type="button"
      class="button inline-control icon"
      data-action="apply-healing"
      data-tooltip="{{localize "l5r4.ui.mechanics.wounds.applyHealingTitle"}}"
      aria-label="{{localize "l5r4.ui.mechanics.wounds.applyHealingTitle"}}"
    >
      <i class="fa-solid fa-bed" inert></i>
    </button>
    <button
      type="button"
      class="button inline-control icon"
      data-action="open-wound-config"
      data-tooltip="{{localize "l5r4.apps.woundConfig.title"}}"
      aria-label="{{localize "l5r4.apps.woundConfig.title"}}"
    >
      <i class="fa-solid fa-gear" inert></i>
    </button>
  </div>
  <div class="l5r4-grid">
    <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.wounds.suffered"}}</span>
    <div class="flexrow l5r4-grid-value"><input
        type="number"
        name="system.suffered"
        value="{{system.suffered}}"
        data-type="Number"
        aria-label="{{localize "l5r4.ui.mechanics.wounds.suffered"}}"
      /></div>

    {{#if (eq actor.type "pc")}}
      <span class="l5r4-grid-label" data-tooltip="{{localize "l5r4.ui.mechanics.wounds.healRateBreakdown" sta=system.traits.sta rank=system.insight.rank mod=system.wounds.mod}}">{{localize "l5r4.ui.mechanics.wounds.woundHealRate"}}</span>
      <div class="flexrow l5r4-grid-value">{{system.wounds.healRate}}</div>
    {{/if}}

    {{#if (and (eq actor.type "npc") (eq system.woundMode "manual"))}}
      <span class="l5r4-grid-label">{{localize "l5r4.ui.mechanics.wounds.maxWounds"}}</span>
      <div class="flexrow l5r4-grid-value"><input
          type="number"
          value="{{system.wounds.max}}"
          data-type="Number"
          disabled
        /></div>
    {{/if}}

    {{#if (eq actor.type "npc")}}
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_wound-track.hbs" levels=system.visibleWoundLevels editable=false}}
    {{else}}
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_wound-track.hbs" levels=system.woundLevels editable=false}}
    {{/if}}
  </div>

</section>