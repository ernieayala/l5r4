<form class="l5r4-sheet {{cssClass}}" autocomplete="off">
  <div class="l5r4-sheet-body">
    {{> "systems/l5r4-enhanced/templates/actor/_partials/_stats-npc.hbs"}}
    <div class="flexcol -gap-sm l5r4-sheet-sidebar">
      <img class="l5r4-portrait" src="{{actor.img}}" data-edit="img" data-actor-image alt="{{actor.name}}" data-tooltip="{{actor.name}}" />
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_combat.hbs"}}
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_armor.hbs"}}
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_wounds.hbs"}}
      {{> "systems/l5r4-enhanced/templates/actor/_partials/_fear.hbs"}}
    </div>
  </div>
</form>
