<section class="l5r4-xp-manager-body standard-form">
  <div class="l5r4-xp-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.character.experience.summary"}}</h3>
    <div class="form-group">
      <label>{{localize "l5r4.character.experience.usedTotal"}}</label>
      <div class="form-fields">
        <input type="text" disabled value="{{xp.spent}} / {{xp.total}}" />
      </div>
    </div>
  </div>
  <ul class="l5r4-xp-manager-breakdown">
    <li><span><strong>{{localize "l5r4.character.experience.breakdown.base"}}</strong>:</span>
      <span>{{xp.breakdown.base}}</span></li>
    {{#if xp.breakdown.disadvantagesGranted}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.disadvantagesGrant"
            }}</strong>:</span>
        <span>{{xp.breakdown.disadvantagesGranted}}
          (<button type="button" class="l5r4-xp-manager-cap" data-action="change-disadvantage-cap" data-tooltip="{{localize "l5r4.character.experience.changeDisadvantageCap"}}">{{localize "l5r4.character.experience.breakdown.cap"}} {{disadvantageCap}}</button>)</span></li>{{/if}}
    {{#if xp.breakdown.manual}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.manualAdjustments"
            }}</strong>:</span>
        <span>{{xp.breakdown.manual}}</span></li>{{/if}}
    {{#if xp.breakdown.traits}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.traits"
            }}</strong>:</span>
        <span>{{xp.breakdown.traits}}</span></li>{{/if}}
    {{#if xp.breakdown.void}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.void"
            }}</strong>:</span>
        <span>{{xp.breakdown.void}}</span></li>{{/if}}
    {{#if xp.breakdown.skills}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.skills"
            }}</strong>:</span>
        <span>{{xp.breakdown.skills}}</span></li>{{/if}}
    {{#if xp.breakdown.advantages}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.advantages"
            }}</strong>:</span>
        <span>{{xp.breakdown.advantages}}</span></li>{{/if}}
    {{#if xp.breakdown.kata}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.kata"
            }}</strong>:</span>
        <span>{{xp.breakdown.kata}}</span></li>{{/if}}
    {{#if xp.breakdown.kiho}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.kiho"
            }}</strong>:</span>
        <span>{{xp.breakdown.kiho}}</span></li>{{/if}}
    {{#if xp.breakdown.spells}}<li><span><strong>{{localize
              "l5r4.character.experience.breakdown.spells"
            }}</strong>:</span>
        <span>{{xp.breakdown.spells}}</span></li>{{/if}}
  </ul>
  <div class="l5r4-xp-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.character.experience.adjustExperience"}}</h3>
    <div class="form-group">
      <label>{{localize "l5r4.character.experience.xpAmount"}}</label>
      <div class="form-fields">
        <input type="number" data-field="xp-amount" name="xp-amount" step="1" value="1" />
      </div>
    </div>
    <div class="form-group">
      <label>{{localize "l5r4.character.experience.note"}}</label>
      <div class="form-fields">
        <input
          type="text"
          data-field="xp-note"
          name="xp-note"
          placeholder="{{localize 'l5r4.character.experience.reason'}}"
        />
      </div>
    </div>
    <div class="form-group">
      <div class="form-fields">
        <button type="button" data-action="add-xp">
          <i class="fa-solid fa-plus" inert></i>
          {{localize "l5r4.ui.common.ok"}}
        </button>
      </div>
    </div>
  </div>
  <div class="l5r4-xp-manager-group flexcol -gap-sm">
    <section class="l5r4-item-row-list -xp l5r4-sort-header">
      <div class="l5r4-item-row">
        <span>{{localize "l5r4.ui.common.xp"}}</span>
        <span>{{localize "l5r4.character.experience.note"}}</span>
        <span></span>
      </div>
    </section>
    <section class="l5r4-item-row-list -xp">
      {{#if manualEntries}}
        {{#each manualEntries}}
          <div class="l5r4-item-row -xp -expandable" data-entry-id="{{this.id}}">
            <h4 class="l5r4-item-row-name flexrow -gap-sm">
              <span>{{this.deltaFormatted}}</span>
            </h4>
            <div>{{this.note}}</div>
            <div>
              <button
                type="button"
                class="inline-control icon"
                data-action="delete-xp-entry"
                data-entry-id="{{this.id}}"
                data-tooltip="{{localize "l5r4.ui.common.delete"}}"
                aria-label="{{localize "l5r4.ui.common.delete"}}"
              >
                <i class="fa-solid fa-trash" inert></i>
              </button>
            </div>
          </div>
        {{/each}}
      {{/if}}
    </section>
  </div>
  <div class="l5r4-xp-manager-group flexcol -gap-sm">
    <div class="flexrow">
      <h3>{{localize "l5r4.character.experience.purchases"}}</h3>
      <button
        type="button"
        class="inline-control icon"
        data-action="recalculate-xp"
        data-tooltip="{{localize 'l5r4.character.experience.recalculate'}}"
        aria-label="{{localize "l5r4.character.experience.recalculate"}}"
      ><i class="fa-solid fa-arrows-rotate" inert></i></button>
    </div>
    <section class="l5r4-item-row-list -xp-spent l5r4-sort-header" data-scope="xp-purchases">
      <div class="l5r4-item-row">
        <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="note">{{localize
            "l5r4.character.experience.reason"
          }}</button>
        <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="cost">{{localize
            "l5r4.character.experience.xpAmount"
          }}</button>
        <button type="button" class="l5r4-sort-header-button" data-action="sort-items" data-sortby="type">{{localize
            "l5r4.ui.common.type"
          }}</button>
      </div>
    </section>
    <section class="l5r4-item-row-list -xp-spent">
      {{#if spentEntries}}
        {{#each spentEntries}}
          <div class="l5r4-item-row -xp-spent -expandable">
            <h4 class="l5r4-item-row-name flexrow -gap-sm">
              <span>{{this.note}}</span>
            </h4>
            <div>{{this.deltaFormatted}}</div>
            <div>{{this.type}}</div>
          </div>
        {{/each}}
      {{/if}}
    </section>
  </div>
</section>