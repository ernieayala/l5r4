<section class="l5r4-wealth-manager-body standard-form">
  <div class="l5r4-wealth-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.apps.wealthManager.currentWealth"}}</h3>
    <div class="l5r4-wealth-manager-display flexrow -gap-md">
      <div class="l5r4-wealth-manager-item">
        <label>{{localize "l5r4.world.wealth.koku"}}</label>
        <div class="l5r4-wealth-manager-value">{{wealth.koku}}</div>
      </div>
      <div class="l5r4-wealth-manager-item">
        <label>{{localize "l5r4.world.wealth.bu"}}</label>
        <div class="l5r4-wealth-manager-value">{{wealth.bu}}</div>
      </div>
      <div class="l5r4-wealth-manager-item">
        <label>{{localize "l5r4.world.wealth.zeni"}}</label>
        <div class="l5r4-wealth-manager-value">{{wealth.zeni}}</div>
      </div>
    </div>
  </div>

  <div class="l5r4-wealth-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.apps.wealthManager.addMoney"}}</h3>
    {{> "systems/l5r4-enhanced/templates/apps/_partials/_wealth-change.hbs" field="add"}}
    <div class="form-group">
      <div class="form-fields">
        <button type="button" data-action="add-money">
          <i class="fa-solid fa-plus" inert></i>
          {{localize "l5r4.apps.wealthManager.add"}}
        </button>
      </div>
    </div>
  </div>

  <div class="l5r4-wealth-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.apps.wealthManager.removeMoney"}}</h3>
    {{> "systems/l5r4-enhanced/templates/apps/_partials/_wealth-change.hbs" field="remove"}}
    <div class="form-group">
      <div class="form-fields">
        <button type="button" data-action="remove-money">
          <i class="fa-solid fa-minus" inert></i>
          {{localize "l5r4.apps.wealthManager.remove"}}
        </button>
      </div>
    </div>
  </div>

  <div class="l5r4-wealth-manager-group flexcol -gap-sm">
    <h3>{{localize "l5r4.apps.wealthManager.convert"}}</h3>
    <div class="l5r4-wealth-manager-convert flexrow -gap-sm">
      <button type="button" data-action="convert-up" data-from="zeni" data-tooltip="{{localize "l5r4.apps.wealthManager.convertZeniToBu"}}">
        <i class="fa-solid fa-arrow-up" inert></i>
        10 {{localize "l5r4.world.wealth.zeni"}} → 1 {{localize "l5r4.world.wealth.bu"}}
      </button>
      <button type="button" data-action="convert-down" data-from="bu" data-tooltip="{{localize "l5r4.apps.wealthManager.convertBuToZeni"}}">
        <i class="fa-solid fa-arrow-down" inert></i>
        1 {{localize "l5r4.world.wealth.bu"}} → 10 {{localize "l5r4.world.wealth.zeni"}}
      </button>
    </div>
    <div class="l5r4-wealth-manager-convert flexrow -gap-sm">
      <button type="button" data-action="convert-up" data-from="bu" data-tooltip="{{localize "l5r4.apps.wealthManager.convertBuToKoku"}}">
        <i class="fa-solid fa-arrow-up" inert></i>
        5 {{localize "l5r4.world.wealth.bu"}} → 1 {{localize "l5r4.world.wealth.koku"}}
      </button>
      <button type="button" data-action="convert-down" data-from="koku" data-tooltip="{{localize "l5r4.apps.wealthManager.convertKokuToBu"}}">
        <i class="fa-solid fa-arrow-down" inert></i>
        1 {{localize "l5r4.world.wealth.koku"}} → 5 {{localize "l5r4.world.wealth.bu"}}
      </button>
    </div>
  </div>
</section>
