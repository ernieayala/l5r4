<section class="standard-form">
  <div class="form-group">
    <label>{{localize "l5r4.ui.mechanics.wounds.armorTn"}}</label>
    <input
      type="number"
      name="armorTn.mod"
      value="{{system.armorTn.mod}}"
      data-type="Number"
      data-action="field-change"
    />
  </div>

  <div class="form-group">
    <label>{{localize "l5r4.ui.mechanics.wounds.armorReduction"}}</label>
    <input
      type="number"
      name="armorTn.reductionMod"
      value="{{system.armorTn.reductionMod}}"
      data-type="Number"
      data-action="field-change"
    />
  </div>

  <div class="form-group">
    <label>{{localize "l5r4.ui.armor.allowStacking"}}</label>
    <input
      type="checkbox"
      name="allowArmorStacking"
      {{checked allowArmorStacking}}
      data-action="field-change"
    />
  </div>
</section>
