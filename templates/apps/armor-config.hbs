<section class="l5r4-armor-config-body standard-form">
  <div class="form-group">
    <label>{{localize "l5r4.ui.mechanics.wounds.armorTn"}}</label>
    <input
      type="number"
      name="armorTn.mod"
      value="{{source.armorTn.mod}}"
      data-type="Number"
      data-action="update-field"
    />
    {{> "systems/l5r4-enhanced/templates/apps/_partials/_added-hint.hbs" added=(lookup added "armorTn.mod")}}
  </div>

  <div class="form-group">
    <label>{{localize "l5r4.ui.mechanics.wounds.armorReduction"}}</label>
    <input
      type="number"
      name="armorTn.reductionMod"
      value="{{source.armorTn.reductionMod}}"
      data-type="Number"
      data-action="update-field"
    />
    {{> "systems/l5r4-enhanced/templates/apps/_partials/_added-hint.hbs" added=(lookup added "armorTn.reductionMod")}}
  </div>

  <div class="form-group">
    <label>{{localize "l5r4.ui.armor.allowStacking"}}</label>
    <input
      type="checkbox"
      name="allowArmorStacking"
      {{checked allowArmorStacking}}
      data-action="update-field"
    />
  </div>
</section>
