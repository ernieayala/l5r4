<div class="l5r4-emphasis-manager-body">
  <p>{{localize "l5r4.apps.emphasisManager.hint"}}</p>
  <button type="button" data-action="add-emphasis">
    <i class="fa-solid fa-plus" inert></i>
    {{localize "l5r4.apps.emphasisManager.addCustom"}}
  </button>
  <div class="l5r4-emphasis-manager-list">
    {{#if emphasisList.length}}
      <ul>
        {{#each emphasisList}}
          <li class="{{#if this.custom}}l5r4-emphasis-manager-item -custom{{/if}}">
            <label>
              <input 
                type="checkbox" 
                name="emphasis.{{this.name}}" 
                {{checked this.available}}
                data-type="Boolean"
              />
              <span>{{this.name}}</span>
              {{#if this.custom}}
                <span>({{localize "l5r4.apps.emphasisManager.custom"}})</span>
              {{/if}}
            </label>
            {{#if this.custom}}
              <div class="l5r4-inline-control flexrow -gap-sm">
                <button
                  type="button" 
                  class="button inline-control icon" 
                  data-action="edit-emphasis" 
                  data-emphasis-name="{{this.name}}"
                  data-tooltip="{{localize 'l5r4.ui.common.edit'}}"
                  aria-label="{{localize "l5r4.ui.common.edit"}}"
                >
                  <i class="fa-solid fa-pen-to-square" inert></i>
                </button>
                <button 
                  type="button" 
                  class="button inline-control icon" 
                  data-action="delete-emphasis" 
                  data-emphasis-name="{{this.name}}"
                  data-tooltip="{{localize 'l5r4.ui.common.delete'}}"
                  aria-label="{{localize "l5r4.ui.common.delete"}}"
                >
                  <i class="fa-solid fa-trash" inert></i>
                </button>
              </div>
            {{/if}}
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p>{{localize "l5r4.apps.emphasisManager.noEmphases"}}</p>
    {{/if}}
  </div>
  <footer class="l5r4-emphasis-manager-footer flexrow -gap-sm">
    <button type="submit">
      <i class="fa-solid fa-floppy-disk" inert></i>
      {{localize "l5r4.ui.common.save"}}
    </button>
    <button type="button" data-action="close">
      {{localize "l5r4.ui.common.cancel"}}
    </button>
  </footer>
</div>
